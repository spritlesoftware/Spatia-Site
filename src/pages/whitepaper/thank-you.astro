---
import Layout from '@layouts/Layout.astro';
import Navbar from '@components/shared/Navbar.astro';
import Footer from '@components/shared/Footer.astro';
import { WHITEPAPER } from '../../config/leads';
---

<Layout
  title="Thank you | Spatia"
  description="Your whitepaper is ready."
  noindex
>
  <Navbar />
  <main class="relative overflow-hidden bg-white">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true"
      style="background: radial-gradient(ellipse 70% 45% at 50% 0%, rgba(15,74,70,0.08) 0%, transparent 70%);"
    ></div>

    <section class="relative mx-auto flex min-h-[78svh] max-w-[640px] flex-col items-center justify-center px-4 py-24 text-center sm:px-8">
      <div class="mb-7 flex h-14 w-14 items-center justify-center rounded-full bg-[#E6E6EA]">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0F4A46" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </div>

      <h1
        class="font-bold leading-[1.1] tracking-[-0.03em] text-sp-heading"
        style="font-size: clamp(32px, 5vw, 48px);"
      >
        Your whitepaper is ready.
      </h1>

      <a
        href={WHITEPAPER.pdf}
        download
        class="group mt-9 inline-flex items-center justify-center gap-2.5 rounded-xl bg-[#0F4A46] px-7 py-4 text-[16px] font-semibold text-white shadow-[0_12px_28px_-14px_rgba(15,74,70,0.8)] transition-all duration-300 hover:bg-[#0A3330] active:scale-[0.99]"
      >
        Download the PDF
        <svg class="transition-transform duration-300 group-hover:translate-y-0.5" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
      </a>

      <p class="mt-5 text-[14.5px] text-sp-body/60">
        We have also sent the link to your email.
      </p>

      <div class="mt-10 h-px w-16 bg-sp-border"></div>

      <p class="mt-8 max-w-[460px] text-[16px] leading-[1.7] text-sp-body/75">
        Want to see it on your own part? Book a 30-minute line review, or visit our Experience Centre in Chennai.
      </p>

      <a
        href="/contact/"
        class="mt-5 inline-flex items-center justify-center gap-2 rounded-xl border border-[#0F4A46] px-6 py-3.5 text-[15px] font-semibold text-[#0F4A46] transition-all duration-300 hover:bg-[#0F4A46] hover:text-white active:scale-[0.99]"
      >
        Book a line review
      </a>
    </section>
  </main>
  <Footer />
</Layout>
