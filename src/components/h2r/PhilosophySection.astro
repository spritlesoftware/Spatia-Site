---
---

<section class="py-[120px]" style="background: #EDF4F4;">
  <div class="max-w-[1280px] mx-auto px-8 md:px-16">

    <!-- Large white rounded card -->
    <div
      class="rounded-[32px] overflow-hidden bg-white reveal"
      style="border: 1px solid #E8ECEF; box-shadow: 0 8px 64px rgba(0,0,0,0.04);"
    >
      <div class="grid grid-cols-1 md:grid-cols-2" style="min-height: 580px;">

        <!-- Left: Text content -->
        <div class="flex flex-col justify-center px-6 sm:px-12 py-12 md:px-16 md:py-20 reveal">
          <h2
            style="font-size: clamp(34px, 4vw, 56px); font-weight: 700; letter-spacing: -0.03em; color: #101828; line-height: 1.06;"
          >
            Autonomy is a<br />
            <span style="color: #1E686E;">human</span> problem.
          </h2>

          <p
            class="mt-8"
            style="font-size: 16px; line-height: 1.85; color: #667085; max-width: 460px;"
          >
            If we're building intelligent systems that can act in the real world,
            we must first understand ourselves-our values, our biases, and what
            we truly want intelligence to serve.
          </p>

          <p
            class="mt-4"
            style="font-size: 16px; line-height: 1.85; color: #667085; max-width: 460px;"
          >
            True autonomy starts with understanding. Not just data. Not just
            models. But intent. Context. Consequence.
          </p>

          <p
            class="mt-6"
            style="font-size: 15px; font-weight: 600; letter-spacing: -0.01em; color: #101828;"
          >
            That's what we build.
          </p>

          <div class="mt-10">
            <a
              href="#"
              class="inline-flex items-center gap-2 px-6 py-3.5 rounded-md text-[14px] font-semibold tracking-tight active:scale-[0.98] transition-all duration-200"
              style="background-color: #111827; color: #ffffff;"
              onmouseover="this.style.backgroundColor='#000000'"
              onmouseout="this.style.backgroundColor='#111827'"
            >
              Learn More
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        </div>

        <!-- Right: Animated orbital geometry -->
        <div
          class="relative flex items-center justify-center overflow-hidden reveal reveal-delay-2"
          style="background: linear-gradient(145deg, #B8CCCF 0%, #C4D6D9 50%, #B4C9CC 100%); min-height: 380px;"
        >
          <!-- Radial core glow -->
          <div
            class="absolute inset-0 pointer-events-none"
            style="background: radial-gradient(ellipse 60% 55% at 50% 50%, rgba(30,104,110,0.28) 0%, rgba(30,104,110,0.08) 55%, transparent 100%);"
          ></div>

          <svg
            viewBox="0 0 400 400"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            class="relative w-full h-auto max-w-[380px] select-none"
            aria-hidden="true"
          >
            <defs>
              <filter id="phil-glow" x="-60%" y="-60%" width="220%" height="220%">
                <feGaussianBlur in="SourceGraphic" stdDeviation="3" result="blur"/>
                <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
              </filter>
              <radialGradient id="phil-core" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#1E686E" stop-opacity="1"/>
                <stop offset="100%" stop-color="#1E686E" stop-opacity="0.2"/>
              </radialGradient>
            </defs>

            <!-- ── Outer dashed orbit ring + 6 nodes, CW 32s ── -->
            <g>
              <circle cx="200" cy="200" r="172"
                stroke="rgba(30,104,110,0.22)" stroke-width="0.8" stroke-dasharray="4 10"/>
              <circle cx="200"   cy="28"    r="3.5" fill="rgba(30,104,110,0.72)" filter="url(#phil-glow)"/>
              <circle cx="348.9" cy="114"   r="2.5" fill="rgba(30,104,110,0.45)"/>
              <circle cx="348.9" cy="286"   r="3.5" fill="rgba(30,104,110,0.72)" filter="url(#phil-glow)"/>
              <circle cx="200"   cy="372"   r="2.5" fill="rgba(30,104,110,0.45)"/>
              <circle cx="51.1"  cy="286"   r="3.5" fill="rgba(30,104,110,0.72)" filter="url(#phil-glow)"/>
              <circle cx="51.1"  cy="114"   r="2.5" fill="rgba(30,104,110,0.45)"/>
              <animateTransform attributeName="transform" type="rotate"
                from="0 200 200" to="360 200 200" dur="32s" repeatCount="indefinite"/>
            </g>

            <!-- ── Outer hexagon, CCW 22s ── -->
            <g>
              <polygon
                points="200,65 330,135 330,265 200,335 70,265 70,135"
                fill="rgba(30,104,110,0.05)" stroke="rgba(30,104,110,0.36)" stroke-width="1.2"/>
              <animateTransform attributeName="transform" type="rotate"
                from="0 200 200" to="-360 200 200" dur="22s" repeatCount="indefinite"/>
            </g>

            <!-- ── Static star overlay (skip-1 connections of outer hex) ── -->
            <polygon points="200,65 330,265 70,265"
              fill="rgba(30,104,110,0.04)" stroke="rgba(30,104,110,0.18)" stroke-width="0.9"/>
            <polygon points="200,335 330,135 70,135"
              fill="rgba(30,104,110,0.04)" stroke="rgba(30,104,110,0.18)" stroke-width="0.9"/>

            <!-- ── 6 radial spokes from center (static) ── -->
            <line x1="200" y1="200" x2="200"   y2="65"  stroke="rgba(30,104,110,0.13)" stroke-width="0.7" stroke-dasharray="2 6"/>
            <line x1="200" y1="200" x2="330"   y2="135" stroke="rgba(30,104,110,0.13)" stroke-width="0.7" stroke-dasharray="2 6"/>
            <line x1="200" y1="200" x2="330"   y2="265" stroke="rgba(30,104,110,0.13)" stroke-width="0.7" stroke-dasharray="2 6"/>
            <line x1="200" y1="200" x2="200"   y2="335" stroke="rgba(30,104,110,0.13)" stroke-width="0.7" stroke-dasharray="2 6"/>
            <line x1="200" y1="200" x2="70"    y2="265" stroke="rgba(30,104,110,0.13)" stroke-width="0.7" stroke-dasharray="2 6"/>
            <line x1="200" y1="200" x2="70"    y2="135" stroke="rgba(30,104,110,0.13)" stroke-width="0.7" stroke-dasharray="2 6"/>

            <!-- ── Inner hexagon + orbit ring, CW 15s ── -->
            <g>
              <circle cx="200" cy="200" r="112"
                stroke="rgba(30,104,110,0.16)" stroke-width="0.8" stroke-dasharray="2 7"/>
              <polygon
                points="200,112 295,160 295,240 200,288 105,240 105,160"
                fill="rgba(30,104,110,0.07)" stroke="rgba(30,104,110,0.46)" stroke-width="1.5"/>
              <circle cx="200" cy="112" r="3"   fill="rgba(30,104,110,0.85)" filter="url(#phil-glow)"/>
              <circle cx="295" cy="160" r="2.5" fill="rgba(30,104,110,0.65)"/>
              <circle cx="295" cy="240" r="3"   fill="rgba(30,104,110,0.85)" filter="url(#phil-glow)"/>
              <circle cx="200" cy="288" r="2.5" fill="rgba(30,104,110,0.65)"/>
              <circle cx="105" cy="240" r="3"   fill="rgba(30,104,110,0.85)" filter="url(#phil-glow)"/>
              <circle cx="105" cy="160" r="2.5" fill="rgba(30,104,110,0.65)"/>
              <animateTransform attributeName="transform" type="rotate"
                from="0 200 200" to="360 200 200" dur="15s" repeatCount="indefinite"/>
            </g>

            <!-- ── Rotating diamond, CCW 40s ── -->
            <g>
              <polygon
                points="200,152 248,200 200,248 152,200"
                fill="rgba(30,104,110,0.11)" stroke="rgba(30,104,110,0.58)" stroke-width="1.8"/>
              <circle cx="200" cy="152" r="3.5" fill="rgba(30,104,110,0.92)" filter="url(#phil-glow)"/>
              <circle cx="248" cy="200" r="3.5" fill="rgba(30,104,110,0.92)" filter="url(#phil-glow)"/>
              <circle cx="200" cy="248" r="3.5" fill="rgba(30,104,110,0.92)" filter="url(#phil-glow)"/>
              <circle cx="152" cy="200" r="3.5" fill="rgba(30,104,110,0.92)" filter="url(#phil-glow)"/>
              <animateTransform attributeName="transform" type="rotate"
                from="0 200 200" to="-360 200 200" dur="40s" repeatCount="indefinite"/>
            </g>

            <!-- ── Pulsing nucleus rings ── -->
            <circle cx="200" cy="200" r="30" fill="none" stroke="rgba(30,104,110,0.32)" stroke-width="1">
              <animate attributeName="r"       values="26;36;26" dur="3.2s" repeatCount="indefinite"/>
              <animate attributeName="opacity" values="0.55;0.10;0.55" dur="3.2s" repeatCount="indefinite"/>
            </circle>
            <circle cx="200" cy="200" r="18" fill="none" stroke="rgba(30,104,110,0.48)" stroke-width="1.2">
              <animate attributeName="r"       values="16;24;16" dur="3.2s" begin="0.9s" repeatCount="indefinite"/>
              <animate attributeName="opacity" values="0.65;0.15;0.65" dur="3.2s" begin="0.9s" repeatCount="indefinite"/>
            </circle>
            <circle cx="200" cy="200" r="10"
              fill="rgba(30,104,110,0.12)" stroke="rgba(30,104,110,0.55)" stroke-width="1.5"/>
            <!-- Center dot -->
            <circle cx="200" cy="200" r="5" fill="url(#phil-core)" filter="url(#phil-glow)"/>
            <circle cx="200" cy="200" r="2.5" fill="#1E686E"/>

            <!-- ── Ambient blinking particles ── -->
            <circle cx="54"  cy="86"  r="2"   fill="rgba(30,104,110,0.35)">
              <animate attributeName="opacity" values="0.2;0.8;0.2" dur="4.2s" repeatCount="indefinite"/>
            </circle>
            <circle cx="346" cy="84"  r="1.5" fill="rgba(30,104,110,0.28)">
              <animate attributeName="opacity" values="0.15;0.65;0.15" dur="4.2s" begin="1.4s" repeatCount="indefinite"/>
            </circle>
            <circle cx="350" cy="322" r="2"   fill="rgba(30,104,110,0.32)">
              <animate attributeName="opacity" values="0.2;0.75;0.2" dur="4.2s" begin="2.8s" repeatCount="indefinite"/>
            </circle>
            <circle cx="50"  cy="320" r="1.5" fill="rgba(30,104,110,0.25)">
              <animate attributeName="opacity" values="0.15;0.6;0.15" dur="4.2s" begin="0.7s" repeatCount="indefinite"/>
            </circle>
            <circle cx="200" cy="12"  r="2"   fill="rgba(30,104,110,0.28)">
              <animate attributeName="opacity" values="0.2;0.7;0.2" dur="4.2s" begin="2.1s" repeatCount="indefinite"/>
            </circle>
            <circle cx="200" cy="388" r="1.5" fill="rgba(30,104,110,0.22)">
              <animate attributeName="opacity" values="0.15;0.55;0.15" dur="4.2s" begin="3.5s" repeatCount="indefinite"/>
            </circle>
          </svg>
        </div>

      </div>
    </div>

  </div>
</section>
