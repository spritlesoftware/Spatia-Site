---
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const byType = (type: 'tech' | 'business') => allPosts.filter((p) => p.data.blogType === type);

// Representative post for each section card: prefer a featured one, else the latest.
const pick = (type: 'tech' | 'business') => {
  const posts = byType(type);
  return posts.find((p) => p.data.featured) ?? posts[0];
};

const sections = [
  {
    key: 'tech',
    label: 'Tech Blogs',
    blurb: 'Engineering notes, systems, and research on how machines perceive and reason.',
    href: '/h2r/tech',
    count: byType('tech').length,
    hero: pick('tech'),
  },
  {
    key: 'business',
    label: 'Business Blogs',
    blurb: 'Industry perspectives, applications, and the value spatial intelligence unlocks.',
    href: '/h2r/business',
    count: byType('business').length,
    hero: pick('business'),
  },
];
---

<section id="stories" class="py-[120px] bg-white">
  <span id="library" class="block relative" style="top: -96px;" aria-hidden="true"></span>
  <div class="max-w-[1280px] mx-auto px-8 md:px-16">

    <!-- Section header -->
    <div class="mb-14 reveal">
      <p class="section-label">Featured Stories</p>
    </div>

    <!-- Section entry cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {sections.map((section, i) => (
        <a
          href={section.href}
          class={`group relative block rounded-[24px] overflow-hidden cursor-pointer transition-all duration-500 hover:-translate-y-1.5 hover:shadow-[0_28px_70px_rgba(0,0,0,0.14)] reveal reveal-delay-${i + 1}`}
          style="min-height: 420px;"
          aria-label={`Browse ${section.label}`}
        >
          <!-- Background image -->
          {section.hero && (
            <img
              src={section.hero.data.image}
              alt={section.hero.data.imageAlt}
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.06]"
              loading="lazy"
            />
          )}
          <!-- Gradient scrim -->
          <div
            class="absolute inset-0"
            style="background: linear-gradient(to top, rgba(10,15,24,0.92) 0%, rgba(10,15,24,0.55) 42%, rgba(10,15,24,0.15) 100%);"
          ></div>

          <!-- Content -->
          <div class="relative z-10 h-full flex flex-col justify-end p-9">
            <span
              class="self-start text-[11px] font-semibold tracking-[0.16em] uppercase px-3 py-1.5 rounded-full mb-4"
              style="color: #ffffff; background: rgba(30,104,110,0.9); backdrop-filter: blur(4px);"
            >
              {section.count} {section.count === 1 ? 'story' : 'stories'}
            </span>
            <h3
              class="text-white"
              style="font-size: 30px; font-weight: 700; letter-spacing: -0.02em; line-height: 1.15;"
            >
              {section.hero?.data.title}
            </h3>
            <p class="mt-3 max-w-[380px]" style="font-size: 15px; line-height: 1.65; color: rgba(255,255,255,0.82);">
              {section.hero?.data.description}
            </p>

            <span
              class="mt-6 inline-flex items-center gap-2 text-[14px] font-semibold text-white transition-all duration-300 group-hover:gap-3"
            >
              Explore section
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </span>
          </div>
        </a>
      ))}
    </div>

    <!-- View all link -->
    <div class="mt-14 reveal">
      <a
        href="/blog"
        class="inline-flex items-center gap-2.5 text-[15px] font-semibold tracking-[-0.01em] transition-colors duration-200"
        style="color: #1E686E;"
        onmouseover="this.style.color='#165255'"
        onmouseout="this.style.color='#1E686E'"
      >
        View all stories
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

  </div>
</section>
