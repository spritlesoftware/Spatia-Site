---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((post) => post.data.featured)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<section id="stories" class="py-[120px] bg-white">
  <div class="max-w-[1280px] mx-auto px-8 md:px-16">

    <!-- Section header -->
    <div class="mb-14 reveal">
      <p class="section-label">Featured Stories</p>
    </div>

    <!-- Cards grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {posts.map((post, i) => (
        <a
          href={`/blog/${post.id.replace(/\.md$/, '')}`}
          class={`group block bg-white border border-[#E8ECEF] rounded-[24px] overflow-hidden cursor-pointer transition-all duration-500 hover:shadow-[0_20px_60px_rgba(0,0,0,0.08)] hover:-translate-y-1.5 reveal reveal-delay-${i + 1}`}
        >
          <!-- Card image with zoom on hover -->
          <div class="relative overflow-hidden" style="height: 288px;">
            <img
              src={post.data.image}
              alt={post.data.imageAlt}
              class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.05]"
            />
            <!-- Subtle dark vignette at bottom of image -->
            <div
              class="absolute bottom-0 left-0 right-0 pointer-events-none"
              style="height: 80px; background: linear-gradient(to bottom, transparent, rgba(0,0,0,0.12));"
            ></div>
          </div>

          <!-- Card body -->
          <div class="p-8 md:p-9">
            <p class="section-label mb-3">{post.data.category}</p>
            <h3
              style="font-size: 26px; font-weight: 600; letter-spacing: -0.02em; color: #101828; line-height: 1.2;"
            >
              {post.data.title}
            </h3>
            <p
              class="mt-3"
              style="font-size: 15px; line-height: 1.75; color: #667085;"
            >
              {post.data.description}
            </p>

            <!-- Footer row: read time + arrow button -->
            <div class="mt-7 flex items-center justify-between">
              <span style="font-size: 13px; color: #9CA3AF; letter-spacing: 0.02em;">
                {post.data.readTime}
              </span>
              <!-- Circular arrow button -->
              <span
                class="h2r-arrow-btn w-10 h-10 rounded-full border border-[#E8ECEF] flex items-center justify-center transition-all duration-300"
              >
                <svg
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h2r-arrow-icon transition-colors duration-300"
                >
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>

<style>
  /* Default arrow color */
  .h2r-arrow-icon {
    color: #101828;
  }

  /* Card hover: fill green button, white arrow */
  a.group:hover .h2r-arrow-btn {
    background-color: #1E686E;
    border-color: #1E686E;
  }
  a.group:hover .h2r-arrow-icon {
    color: #ffffff !important;
  }
</style>
