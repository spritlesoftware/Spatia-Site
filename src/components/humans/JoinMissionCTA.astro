---
---

<section class="bg-white py-10 sm:py-16 lg:py-32">
  <div class="max-w-container mx-auto px-4 sm:px-8 lg:px-16">

    <!-- CTA card -->
    <div
      class="relative overflow-hidden rounded-[20px] sm:rounded-[28px] lg:rounded-[32px] border border-sp-border p-6 sm:p-10 lg:p-16"
      style="box-shadow: 0 0 0 1px #E8ECEB, 0 40px 120px rgba(30,104,110,0.06);"
    >
      <!-- Background glow -->
      <div
        class="absolute inset-0 pointer-events-none"
        style="background: radial-gradient(ellipse at 80% 50%, rgba(30,104,110,0.055) 0%, transparent 58%);"
        aria-hidden="true"
      ></div>

      <!-- Subtle grid -->
      <div
        class="absolute inset-0 pointer-events-none"
        style="opacity: 0.018; background-image: linear-gradient(#111827 1px, transparent 1px), linear-gradient(to right, #111827 1px, transparent 1px); background-size: 48px 48px;"
        aria-hidden="true"
      ></div>

      <div class="relative grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">

        <!-- Left: Text -->
        <div class="reveal">
          <div class="flex items-center gap-3 mb-8">
            <div class="w-8 h-px bg-sp-green"></div>
            <span class="section-label">Join Our Mission</span>
          </div>

          <h2
            class="font-inter font-bold text-sp-heading tracking-[-0.025em] leading-[1.1] mb-6"
            style="font-size: clamp(32px, 3.5vw, 48px);"
          >
            Want to build<br />Physical AI with us?
          </h2>

          <p class="text-[17px] text-sp-body leading-[1.75] mb-10 max-w-[420px]">
            We&rsquo;re looking for <em class="not-italic text-sp-green">people</em> who think deeply, build with care, and believe that the future of autonomous systems requires genuine <em class="not-italic text-sp-green">understanding</em>-not just pattern matching.
          </p>

          <a
            href="/contact"
            class="inline-flex items-center gap-3 px-8 py-4 rounded-[12px] font-semibold text-[15px] text-white transition-all duration-300 group"
            style="background-color: #111827;"
            onmouseover="this.style.backgroundColor='#000000'"
            onmouseout="this.style.backgroundColor='#111827'"
          >
            View Open Roles
            <svg
              width="16" height="16" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
              class="transition-transform duration-200 group-hover:translate-x-0.5"
            >
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>

        <!-- Right: CSS 3D glass orb -->
        <div class="relative h-[200px] sm:h-[280px] lg:h-[380px] flex items-center justify-center reveal reveal-delay-2">

          <!-- Outer halo ring -->
          <div
            class="absolute w-[160px] h-[160px] sm:w-[240px] sm:h-[240px] lg:w-[320px] lg:h-[320px] rounded-full"
            style="border: 1px solid rgba(30,104,110,0.12); background: radial-gradient(circle at 35% 30%, rgba(255,255,255,0.5), rgba(227,239,239,0.15));"
          ></div>

          <!-- Spinning orbit ring -->
          <div
            class="absolute w-[126px] h-[126px] sm:w-[190px] sm:h-[190px] lg:w-[260px] lg:h-[260px] rounded-full"
            style="border: 1.5px solid rgba(30,104,110,0.22); border-top-color: transparent; animation: spin 10s linear infinite;"
          ></div>

          <!-- Counter-spin orbit ring -->
          <div
            class="absolute w-[96px] h-[96px] sm:w-[148px] sm:h-[148px] lg:w-[200px] lg:h-[200px] rounded-full"
            style="border: 1px dashed rgba(30,104,110,0.16); animation: spin 16s linear infinite reverse;"
          ></div>

          <!-- Core glass sphere -->
          <div
            class="absolute w-[72px] h-[72px] sm:w-[110px] sm:h-[110px] lg:w-[150px] lg:h-[150px] rounded-full"
            style="
              background: radial-gradient(circle at 38% 32%,
                rgba(255,255,255,0.95) 0%,
                rgba(227,239,239,0.65) 38%,
                rgba(30,104,110,0.18) 72%,
                rgba(30,104,110,0.28) 100%
              );
              box-shadow:
                inset -10px -10px 20px rgba(30,104,110,0.14),
                inset 6px 6px 16px rgba(255,255,255,0.85),
                0 16px 48px rgba(30,104,110,0.14);
              border: 1px solid rgba(255,255,255,0.55);
            "
          ></div>

          <!-- Small orb-top right -->
          <div
            class="absolute w-5 h-5 sm:w-9 sm:h-9 rounded-full"
            style="
              top: 18%; right: 16%;
              background: radial-gradient(circle at 32% 28%, rgba(255,255,255,0.9), rgba(30,104,110,0.35));
              box-shadow: 0 4px 16px rgba(30,104,110,0.22);
            "
          ></div>

          <!-- Small orb-bottom left -->
          <div
            class="absolute w-3 h-3 sm:w-6 sm:h-6 rounded-full"
            style="
              bottom: 22%; left: 18%;
              background: radial-gradient(circle at 32% 28%, rgba(255,255,255,0.85), rgba(30,104,110,0.4));
              box-shadow: 0 3px 12px rgba(30,104,110,0.25);
            "
          ></div>

          <!-- Frosted glass badge -->
          <div
            class="absolute bottom-2 right-1 sm:bottom-4 sm:right-2 lg:right-4 w-[120px] sm:w-[148px] p-3 sm:p-4 rounded-[12px] sm:rounded-[16px]"
            style="
              background: rgba(255,255,255,0.72);
              backdrop-filter: blur(12px);
              -webkit-backdrop-filter: blur(12px);
              border: 1px solid rgba(255,255,255,0.8);
              box-shadow: 0 8px 32px rgba(0,0,0,0.06);
            "
          >
            <div class="flex items-center gap-2 mb-2">
              <div class="w-2 h-2 rounded-full bg-sp-green flex-shrink-0"></div>
              <span class="text-sp-green text-[9px] font-bold tracking-[0.12em] uppercase">Hiring Now</span>
            </div>
            <p class="text-sp-heading text-[12px] font-semibold leading-tight">Physical AI Engineers</p>
            <p class="text-sp-body text-[11px] mt-0.5">Coming Soon !</p>
          </div>

        </div>
      </div>
    </div>

    <!-- Whitespace -->
    <div class="h-6 sm:h-10 lg:h-20" aria-hidden="true"></div>
  </div>
</section>

<style>
  @keyframes spin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }
</style>
