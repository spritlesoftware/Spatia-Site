---
---

<section class="relative min-h-[70vh] sm:min-h-[80vh] pt-20 sm:pt-24 flex items-center overflow-hidden bg-white">
  <!-- Engineering grid background -->
  <div
    class="absolute inset-0 pointer-events-none"
    style="opacity:0.025; background-image: linear-gradient(#111827 1px, transparent 1px), linear-gradient(to right, #111827 1px, transparent 1px); background-size: 64px 64px;"
    aria-hidden="true"
  ></div>

  <!-- Green radial glow -->
  <div
    class="absolute inset-0 pointer-events-none"
    style="background: radial-gradient(ellipse at 60% 50%, rgba(30,104,110,0.06) 0%, transparent 65%);"
    aria-hidden="true"
  ></div>

  <div class="relative w-full max-w-container mx-auto px-4 sm:px-8 lg:px-16 py-10 sm:py-16 lg:py-24">
    <div class="max-w-3xl reveal">

      <!-- Headline -->
      <h1
        class="font-inter font-bold text-sp-heading leading-[1.04] tracking-[-0.03em] mb-5 sm:mb-8"
        style="font-size: clamp(36px, 6vw, 80px);"
      >
        <em class="not-italic text-sp-green">Human</em>&nbsp;Perspectives<br />
        Behind Physical AI.
      </h1>

      <!-- Supporting paragraph -->
      <p class="text-[16px] sm:text-[18px] text-sp-body leading-[1.75] max-w-[520px] mb-8 sm:mb-12">
        Meet the engineers, researchers and builders shaping the future of intelligent machines.
      </p>

      <!-- Scroll cue -->
      <div class="flex items-center gap-3 sm:gap-4">
        <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-full border border-sp-border flex items-center justify-center text-sp-body">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"/>
            <polyline points="19 12 12 19 5 12"/>
          </svg>
        </div>
        <span class="section-label text-[11px] sm:text-[12px]" style="letter-spacing: 0.12em;">Scroll to meet the team</span>
      </div>

    </div>
  </div>
</section>
