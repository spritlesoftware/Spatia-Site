---
import techBg from '../../assets/Technology-Hero.png';
---

<section class="py-10 md:py-[80px] bg-white">
  <div class="px-4 sm:px-8 lg:px-16">

    <!-- Card -->
    <div class="reveal relative overflow-hidden rounded-[24px]" style="min-height: 160px;">

      <!-- Background image -->
      <img
        src={techBg.src}
        alt=""
        aria-hidden="true"
        class="absolute inset-0 w-full h-full object-cover"
        loading="lazy"
      />

      <!-- Light overlay to keep text readable -->
      <div class="absolute inset-0 bg-white/80 pointer-events-none"></div>

      <!-- Content row -->
      <div class="relative z-10 flex flex-col sm:flex-row sm:items-center sm:justify-between px-6 sm:px-12 py-8 sm:py-10 gap-6 sm:gap-8">

        <!-- Left: Heading + subtext -->
        <div class="flex-1 min-w-0">
          <h2
            class="font-inter font-bold text-sp-heading leading-[1.1] tracking-[-0.025em] mb-2"
            style="font-size: clamp(22px, 2.4vw, 36px);"
          >
            Every autonomous system<br />
            depends on <span class="text-sp-green">understanding.</span>
          </h2>
          <p class="text-[14px] text-sp-body">
            Spatia exists to make it available by default.
          </p>
        </div>

        <!-- CTA button -->
        <div class="flex-shrink-0">
          <a
            href="/contact"
            class="inline-flex items-center gap-2 px-6 py-3 text-white rounded-md text-[14px] font-semibold whitespace-nowrap active:scale-[0.98] transition-all duration-200"
            style="background-color: #111827;"
            onmouseover="this.style.backgroundColor='#000000'"
            onmouseout="this.style.backgroundColor='#111827'"
          >
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
            Request Access
          </a>
        </div>

      </div>
    </div>

  </div>
</section>
