---
// Hero-Slide.mp4 lives in /public/
---

<section class="relative min-h-screen flex items-center pt-24 bg-white overflow-hidden">

  <!-- Engineering grid background -->
  <div
    class="absolute inset-0 pointer-events-none z-0"
    style="opacity:0.025; background-image: linear-gradient(#111827 1px, transparent 1px), linear-gradient(to right, #111827 1px, transparent 1px); background-size: 64px 64px;"
    aria-hidden="true"
  ></div>

  <!-- Subtle background radial gradient -->
  <div
    class="pointer-events-none absolute inset-0 z-0"
    style="background: radial-gradient(ellipse 80% 60% at 65% 50%, rgba(30,104,110,0.045) 0%, transparent 70%);"
  ></div>

  <div class="relative z-10 px-4 sm:px-8 lg:px-16 w-full py-16">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 xl:gap-20 items-center">

      <!-- ── LEFT: Text content ─────────────────────────────── -->
      <div class="reveal">
        <!-- Main heading -->
        <h1
          class="font-inter font-bold text-sp-heading leading-[1.05] tracking-[-0.025em] mb-7"
          style="font-size: clamp(48px, 5.5vw, 72px);"
        >
          The world<br />
          makes sense<br />
          to <span class="text-black">people.</span>
        </h1>

        <!-- Sub-headline -->
        <p class="text-[15px] font-semibold text-sp-heading mb-2 leading-relaxed">
          Machines need help.
        </p>

        <!-- Description -->
        <p class="text-[16px] text-sp-body leading-[1.75] mb-10 max-w-[400px]">
          Spatia gives autonomous systems the ability<br class="hidden lg:block" />
          to understand the environments they operate in.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap gap-3">
          <!-- Primary -->
          <a
            href="/contact"
            class="inline-flex items-center gap-2 px-6 py-3.5 rounded-md text-[14px] font-semibold tracking-tight active:scale-[0.98] transition-all duration-200"
            style="background-color: #111827; color: #ffffff;"
            onmouseover="this.style.backgroundColor='#000000'"
            onmouseout="this.style.backgroundColor='#111827'"
          >
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
            Request Access
          </a>

          <!-- Secondary outline -->
          <button
            class="inline-flex items-center gap-2 px-6 py-3.5 border border-sp-border text-sp-heading rounded-md text-[14px] font-medium hover:bg-gray-50 hover:border-sp-body/30 active:scale-[0.98] transition-all duration-200"
          >
            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" class="text-sp-heading">
              <polygon points="5 3 19 12 5 21 5 3"/>
            </svg>
            Watch Film
          </button>
        </div>
      </div>

      <!-- ── RIGHT: Image + Status panel ───────────────────── -->
      <div class="reveal reveal-delay-2 relative">

        <!-- Image container with rounded corners and frame markers -->
        <div class="relative rounded-2xl overflow-hidden h-[300px] sm:h-[400px] lg:h-[520px]">

          <!-- Corner frame markers -->
          <div class="absolute top-4 left-4 z-20 w-5 h-5 border-l-[2px] border-t-[2px] border-white/60 rounded-tl-sm pointer-events-none"></div>
          <div class="absolute top-4 right-4 z-20 w-5 h-5 border-r-[2px] border-t-[2px] border-white/60 rounded-tr-sm pointer-events-none"></div>
          <div class="absolute bottom-4 left-4 z-20 w-5 h-5 border-l-[2px] border-b-[2px] border-white/60 rounded-bl-sm pointer-events-none"></div>
          <div class="absolute bottom-4 right-4 z-20 w-5 h-5 border-r-[2px] border-b-[2px] border-white/60 rounded-br-sm pointer-events-none"></div>

          <!-- Hero background video -->
          <video
            class="absolute inset-0 w-full h-full object-cover"
            src="/Hero-Slide.mp4"
            autoplay
            muted
            loop
            playsinline
            preload="auto"
          ></video>

          <!-- Subtle gradient overlay at bottom for depth -->
          <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-black/10 pointer-events-none"></div>


        </div>
        <!-- /image container -->

      </div>
      <!-- /right -->

    </div>
  </div>
</section>
