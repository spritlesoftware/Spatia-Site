---
const email = 'spatia@spritle.com';

const socials = [
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/showcase/spatia-intelligence/',
    iconPath: `<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" fill="none"/><rect x="2" y="9" width="4" height="12" stroke="currentColor" stroke-width="1.6" rx="0.5" fill="none"/><circle cx="4" cy="4" r="2" stroke="currentColor" stroke-width="1.6" fill="none"/>`,
  },
  {
    label: 'Instagram',
    href: 'https://www.instagram.com/spatia.sg/',
    iconPath: `<rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke="currentColor" stroke-width="1.6" fill="none"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" stroke="currentColor" stroke-width="1.6" fill="none"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>`,
  },
  {
    label: 'YouTube',
    href: 'https://www.youtube.com/@spatia.intelligence',
    iconPath: `<path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 0 0-1.95 1.96A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.41 19.1C5.12 19.56 12 19.56 12 19.56s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.95 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.42z" stroke="currentColor" stroke-width="1.6" fill="none"/><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" fill="currentColor"/>`,
  },
  {
    label: 'GitHub',
    href: '#',
    iconPath: `<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" fill="none"/>`,
  },
];
---

<section class="py-[120px] bg-white" id="contact-direct">
  <div class="max-w-[1280px] mx-auto px-8 md:px-16">

    <!-- Section label -->
    <div class="reveal mb-16 text-center">
      <span class="section-label" style="color: #1F7A5A;">DIRECT CONTACT</span>
    </div>

    <!-- Premium communication card -->
    <div
      class="reveal relative max-w-[700px] mx-auto rounded-[32px] overflow-hidden"
      style="background: #ffffff; border: 1px solid #E6EAF0;"
    >
      <!-- Soft green glow behind the card -->
      <div
        class="absolute inset-0 pointer-events-none"
        style="background: radial-gradient(ellipse 80% 60% at 50% 0%, rgba(31,122,90,0.06) 0%, transparent 65%);"
        aria-hidden="true"
      ></div>

      <!-- Inner padding -->
      <div class="relative z-10 px-10 md:px-14 py-14 md:py-16 flex flex-col items-center text-center">

        <!-- Icon badge -->
        <div
          class="w-14 h-14 rounded-[16px] flex items-center justify-center mb-8"
          style="background: #EEF8F2; border: 1px solid rgba(31,122,90,0.15);"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#1F7A5A" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
        </div>

        <!-- Eyebrow -->
        <p class="mb-4 text-[12px] font-semibold tracking-[0.2em] uppercase" style="color: #1F7A5A;">
          Email us directly
        </p>

        <!-- Large email address -->
        <a
          href={`mailto:${email}`}
          class="email-link font-bold text-[#111827] tracking-[-0.03em] leading-none hover:text-[#1F7A5A] transition-colors duration-300 break-all"
          style="font-size: clamp(22px, 3.5vw, 36px);"
        >
          {email}
        </a>

        <!-- Action buttons -->
        <div class="flex flex-wrap items-center justify-center gap-3 mt-8">
          <!-- Copy button -->
          <button
            id="copy-email-btn"
            class="copy-btn flex items-center gap-2 px-5 py-2.5 rounded-full text-[13px] font-semibold transition-all duration-300"
            style="background: #EEF8F2; color: #1F7A5A; border: 1px solid rgba(31,122,90,0.2);"
            data-email={email}
            aria-label="Copy email address"
          >
            <svg id="copy-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
            </svg>
            <span id="copy-label">Copy Email</span>
          </button>

          <!-- Open email client -->
          <a
            href={`mailto:${email}`}
            class="flex items-center gap-2 px-5 py-2.5 rounded-full text-[13px] font-semibold transition-all duration-200 active:scale-[0.97]"
            style="background: #111827; color: #ffffff;"
            onmouseover="this.style.background='#000000'"
            onmouseout="this.style.background='#111827'"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
              <polyline points="15 3 21 3 21 9"/>
              <line x1="10" y1="14" x2="21" y2="3"/>
            </svg>
            Open Email
          </a>
        </div>

        <!-- Response time note -->
        <p class="mt-6 text-[13px]" style="color: #B0BAC9;">
          We usually reply within 1–2 business days.
        </p>

        <!-- Divider -->
        <div class="w-full my-10" style="height: 1px; background: #E6EAF0;"></div>

        <!-- Social links -->
        <div>
          <p class="text-[11px] font-semibold tracking-[0.18em] uppercase mb-6" style="color: #B0BAC9;">
            Find us on
          </p>
          <div class="flex items-center justify-center gap-3 flex-wrap">
            {socials.map((s) => (
              <a
                href={s.href}
                aria-label={s.label}
                class="social-btn w-11 h-11 rounded-full flex items-center justify-center transition-all duration-300"
                style="border: 1px solid #E6EAF0; color: #667085;"
              >
                <svg
                  width="18" height="18" viewBox="0 0 24 24"
                  aria-hidden="true"
                  set:html={s.iconPath}
                />
              </a>
            ))}
          </div>
        </div>

      </div>
    </div>

  </div>
</section>

<style>
  .social-btn:hover {
    border-color: rgba(31, 122, 90, 0.3);
    color: #1F7A5A;
    background: #EEF8F2;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(31, 122, 90, 0.1);
  }

  .copy-btn:hover {
    background: rgba(31, 122, 90, 0.1);
    border-color: rgba(31, 122, 90, 0.35);
  }

  .copy-btn.copied {
    background: #1F7A5A;
    color: #ffffff;
    border-color: #1F7A5A;
  }
</style>

<script>
  const btn = document.getElementById('copy-email-btn');
  const label = document.getElementById('copy-label');
  const icon = document.getElementById('copy-icon');

  btn?.addEventListener('click', async () => {
    const email = btn.dataset.email ?? '';
    try {
      await navigator.clipboard.writeText(email);
      btn.classList.add('copied');
      if (label) label.textContent = 'Copied!';
      if (icon) icon.innerHTML = `<polyline points="20 6 9 17 4 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>`;
      setTimeout(() => {
        btn.classList.remove('copied');
        if (label) label.textContent = 'Copy Email';
        if (icon) icon.innerHTML = `<rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>`;
      }, 2200);
    } catch {
      // fallback: select the text
    }
  });
</script>
