---
---

<section class="py-[120px] bg-white">
  <div class="max-w-[1280px] mx-auto px-8 md:px-16">

    <!-- Large rounded CTA container -->
    <div
      class="cta-container reveal relative overflow-hidden rounded-[32px]"
      style="background: #ffffff; border: 1px solid #E6EAF0; box-shadow: 0 4px 64px rgba(31,122,90,0.06), 0 1px 24px rgba(17,24,39,0.04);"
    >
      <!-- Ambient background glow -->
      <div
        class="absolute inset-0 pointer-events-none"
        style="background: radial-gradient(ellipse 70% 80% at 75% 50%, rgba(31,122,90,0.07) 0%, rgba(238,248,242,0.4) 45%, transparent 75%);"
        aria-hidden="true"
      ></div>

      <!-- Grid inner -->
      <div class="relative z-10 grid grid-cols-1 lg:grid-cols-2 min-h-[520px]">

        <!-- ── LEFT: Text content ── -->
        <div class="flex flex-col justify-center px-6 sm:px-10 py-12 md:px-16 md:py-20">

          <!-- Label -->
          <div class="mb-8">
            <span class="section-label" style="color: #1F7A5A;">START A CONVERSATION</span>
          </div>

          <!-- Heading -->
          <h2
            class="font-bold text-[#111827] leading-[1.06] tracking-[-0.035em] mb-6"
            style="font-size: clamp(34px, 4vw, 56px);"
          >
            Let's build something<br>
            <span style="color: #1F7A5A;">meaningful.</span>
          </h2>

          <!-- Paragraph -->
          <p
            class="text-[16px] leading-[1.8] mb-10"
            style="color: #667085; max-width: 420px;"
          >
            Whether you're deploying robots, conducting research, or exploring Physical AI 
            we'd love to understand what you're building and where we can help.
          </p>

          <!-- CTA Button -->
          <div>
            <a
              href="mailto:spatia@spritle.com?subject=Let's build something"
              class="cta-btn group inline-flex items-center gap-3 px-8 py-4 rounded-[14px] text-[15px] font-semibold transition-all duration-300 active:scale-[0.98]"
              style="background: #111827; color: #ffffff;"
            >
              <span>Start the Conversation</span>
              <span class="cta-arrow transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </span>
            </a>
          </div>

          <!-- Subtext -->
          <p class="mt-6 text-[13px]" style="color: #B0BAC9;">
            Or email us directly at
            <a href="mailto:spatia@spritle.com" class="hover:text-[#1F7A5A] transition-colors duration-200" style="color: #667085; text-decoration: underline; text-underline-offset: 3px;">
              spatia@spritle.com
            </a>
          </p>

        </div>

        <!-- ── RIGHT: Glass geometric illustration ── -->
        <div class="relative flex items-center justify-center py-12 lg:py-0 overflow-hidden">

          <!-- Radial glow behind illustration -->
          <div
            class="absolute inset-0 pointer-events-none"
            style="background: radial-gradient(ellipse 65% 65% at 50% 50%, rgba(31,122,90,0.1) 0%, rgba(31,122,90,0.03) 55%, transparent 80%);"
            aria-hidden="true"
          ></div>

          <!-- Glass crystal SVG -->
          <svg
            viewBox="0 0 480 500"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            class="relative w-full max-w-[400px] h-auto select-none"
            aria-hidden="true"
          >
            <defs>
              <!-- Face gradients for glass effect -->
              <linearGradient id="g-top" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%"   stop-color="#EEF8F2" stop-opacity="0.9"/>
                <stop offset="100%" stop-color="#1F7A5A" stop-opacity="0.12"/>
              </linearGradient>
              <linearGradient id="g-tr" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%"   stop-color="#ffffff"  stop-opacity="0.5"/>
                <stop offset="100%" stop-color="#1F7A5A"  stop-opacity="0.08"/>
              </linearGradient>
              <linearGradient id="g-br" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%"   stop-color="#1F7A5A"  stop-opacity="0.1"/>
                <stop offset="100%" stop-color="#1F7A5A"  stop-opacity="0.04"/>
              </linearGradient>
              <linearGradient id="g-tl" x1="1" y1="0" x2="0" y2="1">
                <stop offset="0%"   stop-color="#EEF8F2"  stop-opacity="0.6"/>
                <stop offset="100%" stop-color="#1F7A5A"  stop-opacity="0.06"/>
              </linearGradient>
              <linearGradient id="g-bl" x1="1" y1="0" x2="0" y2="1">
                <stop offset="0%"   stop-color="#1F7A5A"  stop-opacity="0.07"/>
                <stop offset="100%" stop-color="#1F7A5A"  stop-opacity="0.02"/>
              </linearGradient>
              <linearGradient id="g-bot" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%"   stop-color="#1F7A5A"  stop-opacity="0.05"/>
                <stop offset="100%" stop-color="#EEF8F2"  stop-opacity="0.08"/>
              </linearGradient>
              <linearGradient id="g-inner" cx="50%" cy="50%" r="50%" gradientUnits="userSpaceOnUse" x1="240" y1="190" x2="240" y2="320">
                <stop offset="0%"   stop-color="#EEF8F2" stop-opacity="0.8"/>
                <stop offset="100%" stop-color="#1F7A5A" stop-opacity="0.06"/>
              </linearGradient>

              <!-- Glow filter -->
              <filter id="crystal-glow" x="-20%" y="-20%" width="140%" height="140%">
                <feGaussianBlur in="SourceGraphic" stdDeviation="3.5" result="blur"/>
                <feMerge>
                  <feMergeNode in="blur"/>
                  <feMergeNode in="SourceGraphic"/>
                </feMerge>
              </filter>
              <filter id="soft-glow" x="-40%" y="-40%" width="180%" height="180%">
                <feGaussianBlur in="SourceGraphic" stdDeviation="8" result="blur"/>
                <feMerge>
                  <feMergeNode in="blur"/>
                  <feMergeNode in="SourceGraphic"/>
                </feMerge>
              </filter>

              <!-- Outer orbit path for animation -->
              <ellipse id="orbit-path" cx="240" cy="260" rx="175" ry="48"/>
            </defs>

            <!-- ═══ HEXAGONAL GEM ═══ -->
            <!--
              Outer hex center (240,260) radius 150:
                Top:    (240, 110)
                TR:     (370, 185)   [240+130, 260-75]
                BR:     (370, 335)   [240+130, 260+75]
                Bot:    (240, 410)
                BL:     (110, 335)
                TL:     (110, 185)

              Inner hex center (240,260) radius 72:
                Top:    (240, 188)
                TR:     (302, 224)   [240+62, 260-36]
                BR:     (302, 296)
                Bot:    (240, 332)
                BL:     (178, 296)
                TL:     (178, 224)
            -->

            <!-- Outer glow ring -->
            <circle cx="240" cy="260" r="168"
              fill="none" stroke="rgba(31,122,90,0.06)" stroke-width="1.5" stroke-dasharray="3 9"/>

            <!-- ── 6 trapezoidal faces ── -->
            <!-- Face 1 – Top-right (lightest, "lit") -->
            <polygon points="240,110 370,185 302,224 240,188"
              fill="url(#g-top)" stroke="rgba(31,122,90,0.3)" stroke-width="1.2"/>

            <!-- Face 2 – Right -->
            <polygon points="370,185 370,335 302,296 302,224"
              fill="url(#g-tr)" stroke="rgba(31,122,90,0.22)" stroke-width="1"/>

            <!-- Face 3 – Bottom-right -->
            <polygon points="370,335 240,410 240,332 302,296"
              fill="url(#g-br)" stroke="rgba(31,122,90,0.18)" stroke-width="1"/>

            <!-- Face 4 – Bottom-left -->
            <polygon points="240,410 110,335 178,296 240,332"
              fill="url(#g-bl)" stroke="rgba(31,122,90,0.18)" stroke-width="1"/>

            <!-- Face 5 – Left -->
            <polygon points="110,335 110,185 178,224 178,296"
              fill="url(#g-tl)" stroke="rgba(31,122,90,0.2)" stroke-width="1"/>

            <!-- Face 6 – Top-left (medium lit) -->
            <polygon points="110,185 240,110 240,188 178,224"
              fill="url(#g-tl)" stroke="rgba(31,122,90,0.28)" stroke-width="1.2"/>

            <!-- Inner hexagon (core "center face") -->
            <polygon points="240,188 302,224 302,296 240,332 178,296 178,224"
              fill="url(#g-inner)" stroke="rgba(31,122,90,0.35)" stroke-width="1.4"/>


            <!-- Center glow dot -->
            <circle cx="240" cy="260" r="6"
              fill="rgba(31,122,90,0.7)"
              filter="url(#crystal-glow)"/>
            <circle cx="240" cy="260" r="3" fill="#1F7A5A"/>

            <!-- Internal refraction lines (from center to each corner) -->
            <line x1="240" y1="260" x2="240" y2="110"  stroke="rgba(31,122,90,0.10)" stroke-width="0.7" stroke-dasharray="2 6"/>
            <line x1="240" y1="260" x2="370" y2="185"  stroke="rgba(31,122,90,0.10)" stroke-width="0.7" stroke-dasharray="2 6"/>
            <line x1="240" y1="260" x2="370" y2="335"  stroke="rgba(31,122,90,0.10)" stroke-width="0.7" stroke-dasharray="2 6"/>
            <line x1="240" y1="260" x2="240" y2="410"  stroke="rgba(31,122,90,0.10)" stroke-width="0.7" stroke-dasharray="2 6"/>
            <line x1="240" y1="260" x2="110" y2="335"  stroke="rgba(31,122,90,0.10)" stroke-width="0.7" stroke-dasharray="2 6"/>
            <line x1="240" y1="260" x2="110" y2="185"  stroke="rgba(31,122,90,0.10)" stroke-width="0.7" stroke-dasharray="2 6"/>

            <!-- ── Animated outer orbit ring ── -->
            <g>
              <ellipse cx="240" cy="260" rx="185" ry="50"
                stroke="rgba(31,122,90,0.52)" stroke-width="1" fill="none"
                stroke-dasharray="5 12"
                transform="rotate(-15 240 260)"
              >
                <animateTransform attributeName="transform" type="rotate"
                  from="-15 240 260" to="345 240 260" dur="28s" repeatCount="indefinite"/>
              </ellipse>
              <!-- Orbiting dot -->
              <circle cx="425" cy="260" r="5" fill="rgba(31,122,90,0.55)" filter="url(#crystal-glow)">
                <animateTransform attributeName="transform" type="rotate"
                  from="-15 240 260" to="345 240 260" dur="28s" repeatCount="indefinite"/>
              </circle>
            </g>

            <!-- ── Inner orbit ring (counter-rotating) ── -->
            <g>
              <ellipse cx="240" cy="260" rx="110" ry="30"
                stroke="rgba(31,122,90,0.54)" stroke-width="0.8" fill="none"
                stroke-dasharray="3 8"
                transform="rotate(10 240 260)"
              >
                <animateTransform attributeName="transform" type="rotate"
                  from="10 240 260" to="-350 240 260" dur="18s" repeatCount="indefinite"/>
              </ellipse>
              <circle cx="350" cy="260" r="3.5" fill="rgba(31,122,90,0.65)" filter="url(#crystal-glow)">
                <animateTransform attributeName="transform" type="rotate"
                  from="10 240 260" to="-350 240 260" dur="18s" repeatCount="indefinite"/>
              </circle>
            </g>

            <!-- ── Pulsing outer hex nodes ── -->
            <circle cx="240" cy="110" r="4" fill="rgba(31,122,90,0.7)" filter="url(#crystal-glow)">
              <animate attributeName="opacity" values="0.5;1;0.5" dur="3.6s" repeatCount="indefinite"/>
            </circle>
            <circle cx="370" cy="185" r="3" fill="rgba(31,122,90,0.5)">
              <animate attributeName="opacity" values="0.3;0.8;0.3" dur="3.6s" begin="0.6s" repeatCount="indefinite"/>
            </circle>
            <circle cx="370" cy="335" r="3" fill="rgba(31,122,90,0.5)">
              <animate attributeName="opacity" values="0.3;0.8;0.3" dur="3.6s" begin="1.2s" repeatCount="indefinite"/>
            </circle>
            <circle cx="240" cy="410" r="4" fill="rgba(31,122,90,0.6)" filter="url(#crystal-glow)">
              <animate attributeName="opacity" values="0.4;0.9;0.4" dur="3.6s" begin="1.8s" repeatCount="indefinite"/>
            </circle>
            <circle cx="110" cy="335" r="3" fill="rgba(31,122,90,0.5)">
              <animate attributeName="opacity" values="0.3;0.8;0.3" dur="3.6s" begin="2.4s" repeatCount="indefinite"/>
            </circle>
            <circle cx="110" cy="185" r="3" fill="rgba(31,122,90,0.5)">
              <animate attributeName="opacity" values="0.3;0.8;0.3" dur="3.6s" begin="3.0s" repeatCount="indefinite"/>
            </circle>

            <!-- ── Ambient particles ── -->
            <circle cx="58"  cy="138" r="2.5" fill="rgba(31,122,90,0.25)">
              <animate attributeName="opacity" values="0.15;0.6;0.15" dur="4.5s" repeatCount="indefinite"/>
            </circle>
            <circle cx="422" cy="120" r="2"   fill="rgba(31,122,90,0.2)">
              <animate attributeName="opacity" values="0.1;0.5;0.1" dur="4.5s" begin="1.5s" repeatCount="indefinite"/>
            </circle>
            <circle cx="430" cy="380" r="2.5" fill="rgba(31,122,90,0.22)">
              <animate attributeName="opacity" values="0.12;0.55;0.12" dur="4.5s" begin="3s" repeatCount="indefinite"/>
            </circle>
            <circle cx="55"  cy="390" r="2"   fill="rgba(31,122,90,0.18)">
              <animate attributeName="opacity" values="0.1;0.45;0.1" dur="4.5s" begin="2s" repeatCount="indefinite"/>
            </circle>
            <circle cx="240" cy="50"  r="2"   fill="rgba(31,122,90,0.2)">
              <animate attributeName="opacity" values="0.1;0.5;0.1" dur="4.5s" begin="0.8s" repeatCount="indefinite"/>
            </circle>
            <circle cx="240" cy="470" r="2"   fill="rgba(31,122,90,0.15)">
              <animate attributeName="opacity" values="0.1;0.4;0.1" dur="4.5s" begin="2.5s" repeatCount="indefinite"/>
            </circle>

          </svg>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .cta-btn {
    box-shadow: 0 2px 16px rgba(17, 24, 39, 0.2);
  }
  .cta-btn:hover {
    background: #000000 !important;
    box-shadow: 0 8px 28px rgba(17, 24, 39, 0.3);
  }
</style>
