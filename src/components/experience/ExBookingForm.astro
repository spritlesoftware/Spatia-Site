---
const formats = ['In person', 'Live remote session'];

// Same field styling as the homepage contact form
const field =
  'bf-field block w-full rounded-[10px] border border-[#D5DEE6] bg-[#F3F5F7] px-4 py-3 text-[16px] leading-normal text-sp-heading outline-none transition-all duration-200 placeholder:text-[#8592A3] hover:border-[#B9C6D2] focus:border-sp-green focus:bg-white focus:shadow-[0_0_0_4px_rgba(30,104,110,0.1)]';
const label = 'mb-2 block text-[14px] font-semibold text-sp-heading';
---

<section id="book" class="scroll-mt-24 bg-[#F7FAFA] py-16 md:py-[120px]">
  <div class="px-4 sm:px-8 lg:px-16">
    <div class="reveal mx-auto max-w-[44rem]">

      <div class="mb-10 text-center">
        <p class="section-label mb-4">Book a visit</p>
        <h2
          class="mb-3 font-inter font-bold leading-[1.12] tracking-[-0.025em] text-sp-heading"
          style="font-size: clamp(26px, 3vw, 44px);"
        >
          Tell us about your part.
        </h2>
        <p class="mx-auto max-w-[28rem] text-[17px] leading-[1.7] text-sp-body">
          We'll get back to you to confirm a date and what to send ahead.
        </p>
      </div>

      <form class="rounded-[24px] border border-sp-border bg-white p-6 shadow-[0_30px_70px_-40px_rgba(17,24,39,0.3)] sm:p-9" method="post" action="#" novalidate>
        <input type="hidden" name="interest" value="Experience Centre" />

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label for="b-name" class={label}>Name</label>
            <input id="b-name" name="name" type="text" autocomplete="name" required class={field} />
          </div>
          <div>
            <label for="b-email" class={label}>Work email</label>
            <input id="b-email" name="email" type="email" autocomplete="email" required class={field} />
          </div>
          <div class="sm:col-span-2">
            <label for="b-company" class={label}>Company</label>
            <input id="b-company" name="company" type="text" autocomplete="organization" required class={field} />
          </div>
        </div>

        <fieldset class="mt-5">
          <legend class={label}>Visit format</legend>
          <div class="grid grid-cols-1 gap-2.5 sm:grid-cols-2">
            {formats.map((item, i) => (
              <label class="cursor-pointer">
                <input type="radio" name="format" value={item} checked={i === 0} class="peer sr-only" />
                <span class="flex items-center justify-center rounded-[10px] border border-[#D5DEE6] bg-[#F3F5F7] px-4 py-3 text-center text-[15px] font-medium text-sp-body transition-all duration-200 hover:border-sp-green/40 hover:text-sp-heading peer-checked:border-sp-green peer-checked:bg-[#F3F8F8] peer-checked:font-semibold peer-checked:text-sp-green peer-focus-visible:shadow-[0_0_0_4px_rgba(30,104,110,0.15)]">
                  {item}
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        <div class="mt-5">
          <label for="b-part" class={label}>Your part and task</label>
          <textarea
            id="b-part"
            name="message"
            rows={4}
            placeholder="What the part is, how it arrives (bin, tray, conveyor) and what the robot should do with it."
            class={`${field} resize-y`}
          ></textarea>
        </div>

        <div class="mt-5">
          <label for="b-dates" class={label}>Preferred dates <span class="font-normal text-sp-body/70">(optional)</span></label>
          <input id="b-dates" name="dates" type="text" placeholder="e.g. week of 14 December" class={field} />
        </div>

        <div class="mt-8">
          <button
            type="submit"
            class="group flex w-full items-center justify-center gap-2.5 rounded-xl bg-[#123339] px-6 py-4 text-[16px] font-semibold text-white shadow-[0_12px_28px_-14px_rgba(18,51,57,0.8)] transition-all duration-300 hover:bg-[#0B2226] active:scale-[0.99]"
          >
            Request a visit
            <svg class="transition-transform duration-300 group-hover:translate-x-1" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg>
          </button>
          <p class="mt-3 text-center text-[13px] text-sp-body/60">
            Form is not connected to a backend yet.
          </p>
        </div>
      </form>

    </div>
  </div>
</section>

<style>
  .bf-field:user-invalid {
    border-color: #F87171;
    box-shadow: 0 0 0 4px rgba(248, 113, 113, 0.1);
  }
</style>
