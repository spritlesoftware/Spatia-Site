---
import { Image } from 'astro:assets';
import heroImg from '../../assets/experience-centre-hero.jpg';
---

<section class="relative isolate overflow-hidden bg-[#070D0E]">
  <div class="ex-glow pointer-events-none absolute left-[30%] top-1/2 -z-20 h-[40rem] w-[52rem] -translate-x-1/2 -translate-y-1/2 rounded-full" aria-hidden="true"></div>
  <div class="ex-floor pointer-events-none absolute inset-x-0 bottom-0 -z-20 h-[45%]" aria-hidden="true"></div>
  <div class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-24 bg-gradient-to-t from-[#070D0E] to-transparent" aria-hidden="true"></div>

  <div class="grid grid-cols-1 items-center gap-12 px-4 py-16 sm:px-8 md:py-24 lg:grid-cols-12 lg:gap-12 lg:px-16 lg:py-28">

    <div class="lg:col-span-6">
      <p class="reveal section-label mb-5 !text-[#8FD2D8]">Experience Centre</p>

      <h1
        class="reveal font-inter font-bold leading-[1.04] tracking-[-0.04em] text-white"
        style="font-size: clamp(34px, 4.6vw, 66px);"
      >
        See Spatia Nexa
        <span class="block bg-gradient-to-r from-[#8FD2D8] via-[#5FD3A5] to-[#8FD2D8] bg-clip-text pb-[0.08em] text-transparent">run on your parts.</span>
      </h1>

      <p class="reveal reveal-delay-1 mt-6 max-w-[34rem] text-[17px] leading-[1.7] text-white/70 md:text-[18px]">
        Bring a CAD file and your use case. We set up the part in our cell and you watch the
        robot find it and handle it, live, with the engineers who built the system.
      </p>

      <div class="reveal reveal-delay-2 mt-9 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center">
        <a
          href="#book"
          class="inline-flex h-[48px] items-center justify-center gap-2 rounded-full bg-white px-7 text-[15px] font-semibold text-sp-heading transition-shadow duration-300 hover:shadow-[0_0_0_6px_rgba(255,255,255,0.08)]"
        >
          Book a visit
          <span aria-hidden="true">&darr;</span>
        </a>
        <a
          href="#how"
          class="inline-flex h-[48px] items-center justify-center rounded-full border border-white/20 px-7 text-[15px] font-semibold text-white transition-colors duration-200 hover:border-white/40 hover:bg-white/5"
        >
          How a visit works
        </a>
      </div>
    </div>

    <div class="reveal reveal-delay-2 lg:col-span-6">
      <div class="relative overflow-hidden rounded-[24px] border border-white/10">
        <Image
          src={heroImg}
          alt="A collaborative robot arm with a gripper and overhead camera at a workbench in the Spatia Experience Centre"
          widths={[480, 720, 1040, 1400]}
          sizes="(min-width: 1024px) 50vw, 100vw"
          loading="eager"
          class="block aspect-square w-full object-cover object-[50%_55%] lg:aspect-[6/5]"
        />
      </div>
    </div>

  </div>
</section>

<style>
  .ex-glow {
    background: radial-gradient(closest-side, rgba(30, 104, 110, 0.55), rgba(30, 104, 110, 0.15) 55%, transparent);
    filter: blur(20px);
  }
  .ex-floor {
    background-image:
      linear-gradient(rgba(143, 210, 216, 0.22) 1px, transparent 1px),
      linear-gradient(90deg, rgba(143, 210, 216, 0.22) 1px, transparent 1px);
    background-size: 64px 64px;
    transform: perspective(520px) rotateX(62deg);
    transform-origin: bottom center;
    mask-image: linear-gradient(to top, #000 20%, transparent 85%);
    -webkit-mask-image: linear-gradient(to top, #000 20%, transparent 85%);
  }
</style>
