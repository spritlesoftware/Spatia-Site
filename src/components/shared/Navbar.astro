---
import logoSpatia from '../../assets/logo-spatia.svg';

interface Props {
  activeLink?: 'technology' | 'humans' | 'h2r';
}

const { activeLink } = Astro.props;

const links = [
  { label: 'Technology', href: '/technology', id: 'technology' },
  { label: 'Humans',     href: '/humans',     id: 'humans'     },
  { label: 'H2R',        href: '/h2r',        id: 'h2r'        },
];
---

<nav
  id="navbar"
  class="fixed top-0 w-full z-50 h-24 bg-white border-b border-sp-border transition-shadow duration-300"
>
  <div class="flex justify-between items-center px-4 md:px-16 h-full">

    <!-- Logo -->
    <a href="/" class="flex-shrink-0 flex items-center">
      <img src={logoSpatia.src} alt="Spatia" class="h-9 md:h-12 w-auto" />
    </a>

    <!-- Nav links (desktop) -->
    <div class="hidden md:flex items-center gap-12">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={[
            'text-[17px] transition-colors duration-200',
            link.id === activeLink
              ? 'text-sp-heading font-semibold'
              : 'text-sp-body font-medium hover:text-sp-heading',
          ]}
        >
          {link.label}
        </a>
      ))}
    </div>

    <!-- CTA button (desktop) -->
    <a
      href="/contact"
      class="hidden md:flex items-center gap-2.5 px-6 py-3 rounded-md text-[16px] font-semibold transition-all duration-200 active:scale-[0.98]"
      style="background-color: #111827; color: #ffffff;"
      onmouseover="this.style.backgroundColor='#000000'"
      onmouseout="this.style.backgroundColor='#111827'"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
      </svg>
      Request Access
    </a>

    <!-- Mobile hamburger -->
    <button
      id="mobile-menu-btn"
      class="md:hidden p-2 text-sp-body"
      aria-label="Open menu"
      aria-expanded="false"
    >
      <svg id="hamburger-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="3" y1="6"  x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
      <svg id="close-icon" class="hidden" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="18" y1="6"  x2="6"  y2="18"/>
        <line x1="6"  y1="6"  x2="18" y2="18"/>
      </svg>
    </button>

  </div>
</nav>

<!-- Mobile menu panel -->
<div
  id="mobile-menu"
  class="fixed top-24 inset-x-0 z-40 bg-white border-b border-sp-border shadow-lg hidden md:hidden"
>
  <div class="flex flex-col px-4 pb-6 pt-2 gap-1">
    {links.map((link) => (
      <a
        href={link.href}
        class:list={[
          'px-3 py-3.5 rounded-lg text-[16px] font-medium transition-colors duration-150',
          link.id === activeLink
            ? 'text-sp-heading font-semibold bg-gray-50'
            : 'text-sp-body hover:text-sp-heading hover:bg-gray-50',
        ]}
      >
        {link.label}
      </a>
    ))}
    <a
      href="/contact"
      class="mt-3 flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-md text-[15px] font-semibold"
      style="background-color: #111827; color: #ffffff;"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
      </svg>
      Request Access
    </a>
  </div>
</div>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const hamburger = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    if (isOpen) {
      menu?.classList.add('hidden');
      hamburger?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      btn.setAttribute('aria-expanded', 'false');
    } else {
      menu?.classList.remove('hidden');
      hamburger?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
      btn.setAttribute('aria-expanded', 'true');
    }
  });

  // Close when a nav link is tapped
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
      hamburger?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
