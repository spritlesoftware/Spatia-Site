---
import logoSpatia from '../../assets/logo-spatia.svg';

const exploreLinks = [
  { label: 'Technology', href: '/technology' },
  { label: 'Humans',     href: '/humans'     },
  { label: 'H2R',        href: '/h2r'        },
];

const connectLinks = [
  { label: 'Contact',   href: '/contact' },
  { label: 'Join Us',   href: '#' },
  { label: 'LinkedIn',  href: 'https://www.linkedin.com/showcase/spatia-intelligence/' },
  { label: 'Instagram', href: 'https://www.instagram.com/spatia.sg/' },
  { label: 'YouTube',   href: 'https://www.youtube.com/@spatia.intelligence' },
];

const legalLinks = [
  { label: 'Privacy', href: '/privacy' },
  { label: 'Terms',   href: '/terms' },
];
---

<footer class="bg-sp-green text-white">
  <div class="px-4 py-10 sm:px-8 sm:py-16 lg:px-16">

    <div class="grid grid-cols-1 gap-10 md:grid-cols-4 md:gap-8">

      <div class="md:col-span-1">
        <a href="/" class="mb-5 inline-block">
          <img src={logoSpatia.src} alt="Spatia" class="h-10 w-auto brightness-0 invert" />
        </a>
        <p class="max-w-[220px] text-[13px] leading-[1.75] text-white/75">
          Spatia enables machines to perceive, understand and act in the real world.
          We build the foundation for autonomous intelligence.
        </p>
      </div>

      <div>
        <h4 class="section-label mb-5 !text-white/55">Explore</h4>
        <ul class="flex flex-col gap-3.5">
          {exploreLinks.map((link) => <li><a href={link.href} class="footer-link">{link.label}</a></li>)}
        </ul>
      </div>

      <div>
        <h4 class="section-label mb-5 !text-white/55">Connect</h4>
        <ul class="flex flex-col gap-3.5">
          {connectLinks.map((link) => <li><a href={link.href} class="footer-link">{link.label}</a></li>)}
        </ul>
      </div>

      <div>
        <h4 class="section-label mb-5 !text-white/55">Legal</h4>
        <ul class="flex flex-col gap-3.5">
          {legalLinks.map((link) => <li><a href={link.href} class="footer-link">{link.label}</a></li>)}
        </ul>
      </div>

    </div>

    <div
      class="mt-12 flex flex-col items-start justify-between gap-2 border-t border-white/15 pt-6 sm:flex-row sm:items-center"
    >
      <span class="text-[12px] text-white/60"></span>
      <span class="text-[12px] text-white/60">&copy; 2026 Spatia. All rights reserved.</span>
    </div>

  </div>
</footer>

<style>
  .footer-link {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.8);
    transition: color 150ms;
  }
  .footer-link:hover {
    color: #fff;
  }
</style>
