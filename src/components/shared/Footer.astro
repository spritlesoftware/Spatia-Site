---
import logoSpatia from '../../assets/logo-spatia.svg';

const exploreLinks = [
  { label: 'Technology', href: '/technology' },
  { label: 'Humans',     href: '/humans'     },
  { label: 'H2R',        href: '/h2r'        },
];

const connectLinks = [
  { label: 'Contact',   href: '/contact' },
  { label: 'Join Us',   href: '#' },
  { label: 'LinkedIn',  href: 'https://www.linkedin.com/showcase/spatia-intelligence/' },
  { label: 'Instagram', href: 'https://www.instagram.com/spatia.sg/' },
  { label: 'YouTube',   href: 'https://www.youtube.com/@spatia.intelligence' },
];

const legalLinks = [
  { label: 'Privacy', href: '/privacy' },
  { label: 'Terms',   href: '/terms' },
];
---

<footer class="bg-white border-t border-sp-border">
  <div class="px-4 sm:px-8 lg:px-16 py-10 sm:py-16">

    <!-- Four-column grid -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 md:gap-8">

      <!-- Col 1: Brand -->
      <div class="md:col-span-1">
        <a href="/" class="inline-block mb-5">
          <img src={logoSpatia.src} alt="Spatia" class="h-10 w-auto" />
        </a>
        <p class="text-[13px] text-sp-body leading-[1.75] max-w-[220px]">
          Spatia enables machines to perceive, understand and act in the real world.
          We build the foundation for autonomous intelligence.
        </p>
      </div>

      <!-- Col 2: Explore -->
      <div>
        <h4 class="section-label mb-5">Explore</h4>
        <ul class="flex flex-col gap-3.5">
          {exploreLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-[14px] text-sp-body hover:text-sp-heading transition-colors duration-150"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Connect -->
      <div>
        <h4 class="section-label mb-5">Connect</h4>
        <ul class="flex flex-col gap-3.5">
          {connectLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-[14px] text-sp-body hover:text-sp-heading transition-colors duration-150"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 4: Legal -->
      <div>
        <h4 class="section-label mb-5">Legal</h4>
        <ul class="flex flex-col gap-3.5">
          {legalLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-[14px] text-sp-body hover:text-sp-heading transition-colors duration-150"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

    </div>

    <!-- Bottom divider + copyright -->
    <div class="mt-12 pt-6 border-t border-sp-border flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
      <span class="text-[12px] text-sp-body/60"></span>
      <span class="text-[12px] text-sp-body/60">© 2026 Spatia. All rights reserved.</span>
    </div>

  </div>
</footer>
