---
const principles = [
  {
    title: 'CAD-native',
    body: 'The CAD model is the only input a new part needs. Geometry comes from design data, not from collected images.',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.5 20.5 7v10L12 21.5 3.5 17V7z"/><path d="M3.5 7 12 11.5 20.5 7M12 11.5v10"/></svg>`,
  },
  {
    title: 'Deterministic',
    body: 'Perception produces a pose and classical planning moves the robot. No end-to-end learned control sits between them.',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/><path d="M10 6.5h4.5a3 3 0 0 1 3 3V14"/></svg>`,
  },
  {
    title: 'Robot-agnostic',
    body: 'One perception layer between the camera and motion, designed to work across multiple robot brands.',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 9V3M9.4 13.5 4.2 16.5M14.6 13.5l5.2 3"/><circle cx="12" cy="3" r="1.2"/><circle cx="4.2" cy="16.5" r="1.2"/><circle cx="19.8" cy="16.5" r="1.2"/></svg>`,
  },
  {
    title: 'Edge-deployed',
    body: 'Runs on industrial edge hardware beside the cell, without heavy GPU or foundation-model inference.',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="6" width="12" height="12" rx="2"/><rect x="9.5" y="9.5" width="5" height="5" rx="1"/><path d="M9 6V3M15 6V3M9 21v-3M15 21v-3M6 9H3M6 15H3M21 9h-3M21 15h-3"/></svg>`,
  },
];
---

<section class="bg-white py-16 md:py-[120px]">
  <div class="px-4 sm:px-8 lg:px-16">

    <div class="reveal mx-auto mb-12 max-w-[42rem] text-center md:mb-16">
      <p class="section-label mb-4">Design principles</p>
      <h2
        class="font-inter font-bold leading-[1.1] tracking-[-0.025em] text-sp-heading"
        style="font-size: clamp(26px, 3vw, 44px);"
      >
        Built to be predictable on a production line.
      </h2>
    </div>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {principles.map((p, i) => (
        <div class:list={['reveal group rounded-[20px] border border-sp-border bg-white p-6 transition-all duration-300 hover:-translate-y-1 hover:border-sp-green/30 hover:shadow-[0_24px_50px_-30px_rgba(30,104,110,0.45)] lg:p-7', `reveal-delay-${(i % 3) + 1}`]}>
          <span class="mb-6 flex h-11 w-11 items-center justify-center rounded-[12px] bg-sp-green-light text-sp-green transition-colors duration-300 group-hover:bg-sp-green group-hover:text-white">
            <Fragment set:html={p.icon} />
          </span>
          <h3 class="mb-2 text-[20px] font-semibold leading-tight tracking-[-0.02em] text-sp-heading">{p.title}</h3>
          <p class="text-[16px] leading-[1.7] text-sp-body">{p.body}</p>
        </div>
      ))}
    </div>

  </div>
</section>
