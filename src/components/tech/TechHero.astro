---
// Depth "point cloud" of an isometric part: three visible faces, each shaded
// by how directly it faces the camera. The CAD wireframe snaps onto it.
type Pt = [number, number];
const faces: { o: Pt; u: Pt; v: Pt; shade: number }[] = [
  { o: [240, 110], u: [90, 50], v: [-90, 50], shade: 0.95 }, // top
  { o: [150, 160], u: [90, 50], v: [0, 90], shade: 0.6 },    // left
  { o: [240, 210], u: [90, -50], v: [0, 90], shade: 0.35 },  // right
];
const cloud: { x: number; y: number; o: number }[] = [];
let seed = 0;
for (const f of faces) {
  for (let a = 0; a <= 1.001; a += 1 / 13) {
    for (let b = 0; b <= 1.001; b += 1 / 13) {
      const jx = Math.sin(++seed * 12.9898) * 1.6;
      const jy = Math.cos(seed * 78.233) * 1.6;
      cloud.push({
        x: Math.round((f.o[0] + f.u[0] * a + f.v[0] * b + jx) * 10) / 10,
        y: Math.round((f.o[1] + f.u[1] * a + f.v[1] * b + jy) * 10) / 10,
        o: Math.round(f.shade * (0.7 + 0.3 * Math.abs(Math.sin(seed))) * 100) / 100,
      });
    }
  }
}

const readout = [
  { k: 'x', unit: 'mm' }, { k: 'y', unit: 'mm' }, { k: 'z', unit: 'mm' },
  { k: 'roll', unit: 'deg' }, { k: 'pitch', unit: 'deg' }, { k: 'yaw', unit: 'deg' },
];
---

<section class="relative isolate overflow-hidden bg-[#070D0E]">
  <!-- Atmosphere, shared with the "Send us a part" band -->
  <div class="th-glow pointer-events-none absolute left-[70%] top-1/2 -z-20 h-[40rem] w-[52rem] -translate-x-1/2 -translate-y-1/2 rounded-full" aria-hidden="true"></div>
  <div class="th-floor pointer-events-none absolute inset-x-0 bottom-0 -z-20 h-[45%]" aria-hidden="true"></div>
  <div class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-24 bg-gradient-to-t from-[#070D0E] to-transparent" aria-hidden="true"></div>

  <div class="grid grid-cols-1 items-center gap-12 px-4 py-16 sm:px-8 md:py-24 lg:grid-cols-12 lg:gap-10 lg:px-16 lg:py-28">

    <!-- Copy -->
    <div class="lg:col-span-6">
      <p class="reveal section-label mb-5 !text-[#8FD2D8]">Technology · Spatia Nexa</p>

      <h1
        class="reveal font-inter font-bold leading-[1.04] tracking-[-0.04em] text-white"
        style="font-size: clamp(34px, 4.6vw, 66px);"
      >
        From a CAD file to
        <span class="block bg-gradient-to-r from-[#8FD2D8] via-[#5FD3A5] to-[#8FD2D8] bg-clip-text pb-[0.08em] text-transparent">a robot that acts.</span>
      </h1>

      <p class="reveal reveal-delay-1 mt-6 max-w-[34rem] text-[17px] leading-[1.7] text-white/70 md:text-[19px]">
        Physical AI that is CAD-native, deterministic and needs no training data. Spatia Nexa
        turns the model you already have into an exact 6D pose, then carries that pose all the
        way to robot motion.
      </p>

      <div class="reveal reveal-delay-2 mt-9 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center">
        <a
          href="#pipeline"
          class="inline-flex h-[48px] items-center justify-center gap-2 rounded-full bg-white px-7 text-[16px] font-semibold text-sp-heading transition-shadow duration-300 hover:shadow-[0_0_0_6px_rgba(255,255,255,0.08)]"
        >
          See how it works
          <span aria-hidden="true">&darr;</span>
        </a>
        <a
          href="/contact?interest=send-a-part"
          class="inline-flex h-[48px] items-center justify-center rounded-full border border-white/20 px-7 text-[16px] font-semibold text-white transition-colors duration-200 hover:border-white/40 hover:bg-white/5"
        >
          Send us a part
        </a>
      </div>
    </div>

    <!-- Visual: CAD snaps onto the depth scan -->
    <div class="reveal reveal-delay-2 lg:col-span-6">
      <div class="relative mx-auto max-w-[560px] rounded-[28px] border border-white/10 bg-white/[0.03] p-4 backdrop-blur-sm sm:p-6">
        <div class="mb-3 flex items-center justify-between font-mono text-[12px] tracking-[0.14em] text-white/45">
          <span>RGB-D · SCENE</span>
          <span class="th-lock flex items-center gap-1.5 text-[#5FD3A5]">
            <span class="h-1.5 w-1.5 rounded-full bg-[#5FD3A5]"></span>POSE LOCKED
          </span>
        </div>

        <svg class="block w-full" viewBox="0 0 480 360" fill="none" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="A CAD wireframe aligning onto a depth scan of a part, with pose axes">
          <!-- Frame corners -->
          <path d="M20 44V20h24M460 44V20h-24M20 316v24h24M460 316v24h-24" stroke="#8FD2D8" stroke-width="1.4" opacity=".35" />

          <!-- Depth points, offset down 0 so the box sits centred -->
          <g transform="translate(0 -20)">
            {cloud.map((p) => <circle cx={p.x} cy={p.y} r="1.7" fill="#8FD2D8" opacity={p.o} />)}

            <!-- CAD wireframe -->
            <g class="th-cad" stroke="#5FD3A5" stroke-width="1.6" stroke-dasharray="5 4">
              <path d="M240 110 330 160 240 210 150 160z M150 160v90l90 50 90-50v-90 M240 210v90" />
            </g>

            <!-- Pose axes at the top-face centre -->
            <g class="th-axes" stroke-width="2.2">
              <path d="M240 160V78" stroke="#60A5FA" />
              <path d="M240 160l66 36" stroke="#F87171" />
              <path d="M240 160l-66 36" stroke="#5FD3A5" />
              <circle cx="240" cy="160" r="4" fill="#fff" stroke="none" />
            </g>
          </g>

          <rect class="th-scan" x="20" y="20" width="2" height="320" fill="#8FD2D8" />
        </svg>

        <!-- 6D readout: labels only, the values come from the live system -->
        <div class="mt-4 grid grid-cols-3 gap-2 sm:grid-cols-6">
          {readout.map((r) => (
            <div class="rounded-lg border border-white/10 bg-white/[0.03] px-2.5 py-2 text-center">
              <span class="block font-mono text-[13px] font-semibold text-white/85">{r.k}</span>
              <span class="block font-mono text-[11px] tracking-[0.1em] text-white/40">{r.unit}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .th-glow {
    background: radial-gradient(closest-side, rgba(30, 104, 110, 0.55), rgba(30, 104, 110, 0.15) 55%, transparent);
    filter: blur(20px);
  }
  .th-floor {
    background-image:
      linear-gradient(rgba(143, 210, 216, 0.22) 1px, transparent 1px),
      linear-gradient(90deg, rgba(143, 210, 216, 0.22) 1px, transparent 1px);
    background-size: 64px 64px;
    transform: perspective(520px) rotateX(62deg);
    transform-origin: bottom center;
    mask-image: linear-gradient(to top, #000 20%, transparent 85%);
    -webkit-mask-image: linear-gradient(to top, #000 20%, transparent 85%);
  }

  /* One 7s cycle: scan sweeps, CAD drifts in and locks, axes and status appear */
  .th-scan { animation: th-scan 7s cubic-bezier(0.45, 0, 0.55, 1) infinite; }
  @keyframes th-scan {
    0%        { transform: translateX(0);     opacity: 0; }
    4%        { opacity: 0.7; }
    26%       { transform: translateX(438px); opacity: 0.7; }
    28%, 100% { transform: translateX(438px); opacity: 0; }
  }

  .th-cad {
    transform-box: view-box;
    transform-origin: 240px 205px;
    animation: th-cad 7s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }
  @keyframes th-cad {
    0%, 26%   { transform: translate(46px, -30px) rotate(-16deg); opacity: 0; }
    32%       { opacity: 0.9; }
    50%, 92%  { transform: none; opacity: 1; }
    100%      { transform: none; opacity: 0; }
  }

  .th-axes { animation: th-fade 7s ease infinite; }
  .th-lock { animation: th-fade 7s ease infinite; }
  @keyframes th-fade {
    0%, 52%  { opacity: 0; }
    58%, 92% { opacity: 1; }
    100%     { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .th-scan { animation: none; opacity: 0; }
    .th-cad, .th-axes, .th-lock { animation: none; opacity: 1; transform: none; }
  }
</style>
