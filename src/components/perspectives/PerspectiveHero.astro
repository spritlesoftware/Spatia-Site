---
interface Props {
  heroTitle: string;
  heroSubtitle: string;
  role: string;
  number: string;
  readTime: string;
  publishedDate: string;
}

const { heroTitle, heroSubtitle, role, number, readTime, publishedDate } = Astro.props;
---

<section
  class="relative overflow-hidden"
  style="background: #1F7A5A; min-height: 520px;"
>
  <!-- Engineering grid -->
  <div
    class="absolute inset-0 pointer-events-none"
    style="
      background-image:
        linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
      background-size: 48px 48px;
    "
    aria-hidden="true"
  ></div>

  <!-- Radial glow (top right) -->
  <div
    class="absolute inset-0 pointer-events-none"
    style="background: radial-gradient(ellipse 55% 60% at 85% 20%, rgba(255,255,255,0.07) 0%, transparent 65%);"
    aria-hidden="true"
  ></div>

  <!-- Back to Humans -->
  <div class="absolute top-10 left-8 lg:left-16 z-10 hero-animate" style="--delay:0s">
    <a
      href="/humans"
      class="inline-flex items-center gap-2 text-white/55 hover:text-white text-[11px] font-semibold tracking-[0.15em] uppercase transition-colors duration-200"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M19 12H5M12 5l-7 7 7 7"/>
      </svg>
      Humans
    </a>
  </div>

  <!-- Hero content -->
  <div class="relative z-10 max-w-[1280px] mx-auto px-8 lg:px-16 pt-28 pb-20 lg:pt-36 lg:pb-24">

    <!-- Metadata row -->
    <div class="flex flex-wrap items-center gap-3 mb-8 hero-animate" style="--delay:0.1s">
      <span class="text-white/55 text-[10px] font-semibold tracking-[0.22em] uppercase">{role}</span>
      <span class="text-white/30 text-[10px]">·</span>
      <span class="text-white/55 text-[10px] font-semibold tracking-[0.22em] uppercase">Perspective {number}</span>
      <span class="text-white/30 text-[10px]">·</span>
      <span class="text-white/55 text-[10px] font-semibold tracking-[0.22em] uppercase">{readTime}</span>
      <span class="text-white/30 text-[10px]">·</span>
      <span class="text-white/55 text-[10px] font-semibold tracking-[0.22em] uppercase">{publishedDate}</span>
    </div>

    <!-- Title -->
    <h1
      class="text-white font-bold leading-[1.0] tracking-[-0.03em] max-w-[820px] hero-animate"
      style="font-size: clamp(44px, 5.8vw, 80px); --delay:0.2s;"
    >
      {heroTitle}
    </h1>

    <!-- Subtitle -->
    <p
      class="text-white/65 leading-[1.65] mt-5 max-w-[500px] hero-animate"
      style="font-size: 18px; --delay:0.35s;"
    >
      {heroSubtitle}
    </p>

  </div>
</section>

<style>
  @keyframes heroIn {
    from { opacity: 0; transform: translateY(18px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .hero-animate {
    opacity: 0;
    animation: heroIn 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: var(--delay, 0s);
  }
</style>
