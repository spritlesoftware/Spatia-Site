---
---

<section class="py-16 lg:py-20" style="background: #F8FAFA;">
  <div class="max-w-[1280px] mx-auto px-8 lg:px-16">

    <div
      class="relative overflow-hidden rounded-[28px] border reveal"
      style="background: #FFFFFF; border-color: #E8ECEF;"
    >
      <!-- Subtle radial glow -->
      <div
        class="absolute inset-0 pointer-events-none"
        style="background: radial-gradient(ellipse 55% 70% at 90% 50%, rgba(31,122,90,0.05) 0%, transparent 65%);"
        aria-hidden="true"
      ></div>

      <div class="relative grid grid-cols-1 lg:grid-cols-2 gap-8 p-10 lg:p-14 items-center">

        <!-- Left: Text + form -->
        <div>
          <!-- Label -->
          <div class="flex items-center gap-3 mb-6">
            <div class="w-8 h-px" style="background: #1F7A5A;"></div>
            <span class="text-[10px] font-semibold tracking-[0.22em] uppercase" style="color: #1F7A5A;">Newsletter</span>
          </div>

          <!-- Heading -->
          <h2
            class="text-[#111827] font-bold leading-[1.1] tracking-[-0.025em] mb-4"
            style="font-size: clamp(26px, 2.8vw, 36px);"
          >
            More engineering<br />perspectives.
          </h2>

          <!-- Description -->
          <p class="text-[#667085] text-[16px] leading-[1.7] mb-8 max-w-[380px]">
            Thoughtful essays from the people building intelligent machines. Delivered monthly, no fluff.
          </p>

          <!-- Form -->
          <form
            class="flex flex-col sm:flex-row gap-3"
            onsubmit="event.preventDefault(); this.querySelector('button').textContent = 'Subscribed ✓';"
          >
            <input
              type="email"
              placeholder="your@email.com"
              required
              class="flex-1 px-4 py-3 rounded-[12px] border text-[15px] outline-none transition-colors duration-200"
              style="border-color: #E8ECEF; color: #111827; background: #FFFFFF;"
              onfocus="this.style.borderColor='#1F7A5A'; this.style.boxShadow='0 0 0 3px rgba(31,122,90,0.08)'"
              onblur="this.style.borderColor='#E8ECEF'; this.style.boxShadow='none'"
            />
            <button
              type="submit"
              class="flex-shrink-0 px-6 py-3 rounded-[12px] text-white text-[14px] font-semibold tracking-[0.02em] transition-all duration-200"
              style="background: #1F7A5A;"
              onmouseover="this.style.background='#175E44'"
              onmouseout="this.style.background='#1F7A5A'"
            >
              Subscribe
            </button>
          </form>

          <p class="text-[11px] mt-3" style="color: #667085;">No spam. Unsubscribe any time.</p>
        </div>

        <!-- Right: Decorative illustration -->
        <div class="hidden lg:flex justify-center items-center" aria-hidden="true">
          <div class="relative">
            <!-- Outer ring -->
            <div
              class="w-[220px] h-[220px] rounded-full flex items-center justify-center"
              style="background: #EEF8F2; border: 1px solid #D1EEE3;"
            >
              <!-- Middle ring -->
              <div
                class="w-[160px] h-[160px] rounded-full flex items-center justify-center"
                style="background: #FFFFFF; border: 1px solid #D1EEE3;"
              >
                <!-- Inner circle -->
                <div
                  class="w-[100px] h-[100px] rounded-full flex items-center justify-center"
                  style="background: #1F7A5A;"
                >
                  <!-- Letter icon -->
                  <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                    <polyline points="22,6 12,13 2,6"/>
                  </svg>
                </div>
              </div>
            </div>

            <!-- Floating dots -->
            <div class="absolute -top-2 -right-2 w-4 h-4 rounded-full" style="background: #1F7A5A; opacity: 0.3;"></div>
            <div class="absolute bottom-4 -left-4 w-3 h-3 rounded-full" style="background: #1F7A5A; opacity: 0.2;"></div>
            <div class="absolute top-8 -left-6 w-2 h-2 rounded-full" style="background: #1F7A5A; opacity: 0.4;"></div>
          </div>
        </div>

      </div>
    </div>

  </div>
</section>
