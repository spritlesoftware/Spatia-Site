---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface RelatedItem {
  slug: string;
  name: string;
  role: string;
  heroTitle: string;
  readTime: string;
  image: ImageMetadata;
}

interface Props {
  perspectives: RelatedItem[];
}

const { perspectives } = Astro.props;
---

<section class="bg-white py-20 lg:py-28 border-t" style="border-color: #E8ECEF;">
  <div class="max-w-[1280px] mx-auto px-8 lg:px-16">

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-14 reveal">
      <div>
        <div class="flex items-center gap-3 mb-4">
          <div class="w-8 h-px" style="background: #1F7A5A;"></div>
          <span class="text-[10px] font-semibold tracking-[0.22em] uppercase" style="color: #1F7A5A;">Continue Reading</span>
        </div>
        <h2
          class="text-[#111827] font-bold tracking-[-0.025em] leading-[1.1]"
          style="font-size: clamp(28px, 3vw, 40px);"
        >
          More Perspectives
        </h2>
      </div>
      <a
        href="/humans"
        class="inline-flex items-center gap-2 text-[13px] font-semibold transition-colors duration-200 flex-shrink-0"
        style="color: #667085;"
        onmouseover="this.style.color='#1F7A5A'"
        onmouseout="this.style.color='#667085'"
      >
        View all
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

    <!-- Cards grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {perspectives.map((p, i) => (
        <a
          href={`/perspectives/${p.slug}`}
          class:list={[
            'group relative flex flex-col rounded-[24px] border overflow-hidden',
            'transition-all duration-500 ease-out reveal',
            `reveal-delay-${i + 1}`,
          ]}
          style="border-color: #E8ECEF; background: #FFFFFF;"
          onmouseover="this.style.borderColor='#1F7A5A'; this.style.transform='translateY(-6px)'; this.style.boxShadow='0 20px 56px rgba(31,122,90,0.10)'"
          onmouseout="this.style.borderColor='#E8ECEF'; this.style.transform='translateY(0)'; this.style.boxShadow='none'"
        >
          <!-- Portrait -->
          <div class="overflow-hidden h-[300px]" style="background: #EEF8F2;">
            <Image
              src={p.image}
              alt={p.name}
              class="w-full h-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-[1.06]"
              width={400}
              height={300}
            />
          </div>

          <!-- Card body -->
          <div class="p-6 flex flex-col flex-1 gap-3">
            <!-- Role chip -->
            <span
              class="self-start text-[10px] font-semibold tracking-[0.18em] uppercase px-2.5 py-1 rounded-full"
              style="color: #1F7A5A; background: #EEF8F2;"
            >
              {p.role}
            </span>

            <!-- Headline -->
            <h3 class="text-[#111827] font-semibold text-[16px] leading-[1.45] tracking-[-0.01em] flex-1">
              {p.heroTitle}
            </h3>

            <!-- Footer: name + read time + arrow -->
            <div class="flex items-center justify-between mt-2 pt-4 border-t" style="border-color: #E8ECEF;">
              <div>
                <p class="text-[13px] font-semibold text-[#111827]">{p.name}</p>
                <p class="text-[11px] text-[#667085]">{p.readTime}</p>
              </div>
              <div
                class="w-8 h-8 rounded-full flex items-center justify-center transition-all duration-300 group-hover:scale-110"
                style="background: #EEF8F2; color: #1F7A5A;"
                onmouseover="this.parentElement.parentElement.parentElement.parentElement.style.color='white'"
              >
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M7 17L17 7M10 7h7v7"/>
                </svg>
              </div>
            </div>
          </div>

          <!-- Bottom green bar on hover -->
          <div
            class="absolute bottom-0 left-0 right-0 h-[2px] origin-left scale-x-0 group-hover:scale-x-100 transition-transform duration-500"
            style="background: #1F7A5A;"
          ></div>
        </a>
      ))}
    </div>

  </div>
</section>
