---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  role: string;
  image: ImageMetadata;
  yearsAtSpatia: string;
  linkedin: string;
  bio: string;
}

const { name, role, image, yearsAtSpatia, linkedin, bio } = Astro.props;
---

<section class="py-16 lg:py-20" style="background: #F8FAFA;">
  <div class="max-w-[760px] mx-auto px-8 lg:px-0">

    <div class="rounded-[24px] p-8 lg:p-10 border reveal" style="background: #FFFFFF; border-color: #E8ECEF;">

      <!-- Header label -->
      <div class="flex items-center gap-3 mb-8">
        <div class="w-8 h-px" style="background: #1F7A5A;"></div>
        <span class="text-[10px] font-semibold tracking-[0.22em] uppercase" style="color: #1F7A5A;">About the Author</span>
      </div>

      <div class="flex flex-col sm:flex-row gap-6 items-start">

        <!-- Portrait -->
        <div class="flex-shrink-0">
          <div class="w-[80px] h-[80px] rounded-[16px] overflow-hidden ring-1 ring-[#E8ECEF]">
            <Image
              src={image}
              alt={name}
              class="w-full h-full object-cover object-top"
              width={80}
              height={80}
            />
          </div>
        </div>

        <!-- Info -->
        <div class="flex-1 min-w-0">
          <!-- Name + LinkedIn row -->
          <div class="flex flex-wrap items-center gap-3 mb-1">
            <h3 class="text-[#111827] font-bold text-[18px] tracking-[-0.01em]">{name}</h3>
            <a
              href={linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-[11px] font-semibold px-2.5 py-1 rounded-full transition-colors duration-200"
              style="color: #1F7A5A; background: #EEF8F2;"
              onmouseover="this.style.background='#1F7A5A'; this.style.color='#FFFFFF'"
              onmouseout="this.style.background='#EEF8F2'; this.style.color='#1F7A5A'"
            >
              <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
                <rect x="2" y="9" width="4" height="12"/>
                <circle cx="4" cy="4" r="2"/>
              </svg>
              LinkedIn
            </a>
          </div>

          <!-- Role + Years -->
          <p class="text-[#667085] text-[13px] mb-4">{role} &nbsp;·&nbsp; {yearsAtSpatia}</p>

          <!-- Bio -->
          <p class="text-[#4B5563] text-[15px] leading-[1.75]">{bio}</p>
        </div>

      </div>


    </div>
  </div>
</section>
