---
// Illustrated field-note article layout. The Markdown body supplies the content;
// this wrapper supplies the Spatia-watercolour styling and the small enhancements.
---

<div class="wc-article">
  <slot />
</div>

<noscript>
  <style>
    .wc-article .bloom { opacity: var(--o, .85) !important; transform: none !important; }
    .wc-article .brush { stroke-dashoffset: 0 !important; }
    .wc-article .bob { transform: none !important; }
    .wc-article .drop { opacity: 1 !important; transform: none !important; }
  </style>
</noscript>

<script>
  {
    const root = document.querySelector('.wc-article');
    if (root) {
      const figs = root.querySelectorAll('.fig-anim');

      if (!('IntersectionObserver' in window)) {
        figs.forEach((f) => f.classList.add('on'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('on');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.25 }
        );
        figs.forEach((f) => io.observe(f));
      }

      const btn = root.querySelector('#copyask');
      if (btn) {
        btn.addEventListener('click', async () => {
          const items = [...root.querySelectorAll('#asklist li')]
            .map((l, i) => `${i + 1}. ${l.textContent}`)
            .join('\n');
          try {
            await navigator.clipboard.writeText(items);
            btn.textContent = 'Copied';
          } catch (e) {
            btn.textContent = 'Select and copy the list';
          }
          setTimeout(() => (btn.textContent = 'Copy these questions'), 2500);
        });
      }
    }
  }
</script>

<style is:global>
  .wc-article {
    --ink: #0e1114;
    --soft: #4a5553;
    --head: #0f4a46;
    --rule: #d5dad6;
    --sheet: #f6f3ea;
    --teal: #0f4a46;
    --acc: #01ac95;
    --fog: #b7c5c3;
    --ochre: #c98a3a;
    --graph: #0e1114;
    color: var(--ink);
    background: #fff;
    font-family: Geist, system-ui, sans-serif;
    font-size: 18px;
    line-height: 1.75;
  }

  .wc-article * { box-sizing: border-box; min-width: 0; }
  .wc-article .wrap { max-width: 760px; margin: 0 auto; padding: 0 32px; }
  .wc-article .wide { max-width: 1040px; margin: 0 auto; padding: 0 24px; }

  .wc-article h2 {
    font-family: Fraunces, Georgia, serif;
    font-weight: 650;
    font-size: clamp(25px, 3.4vw, 33px);
    line-height: 1.15;
    color: var(--head);
    margin: 56px 0 14px;
    text-wrap: balance;
  }
  .wc-article p { margin: 0 0 20px; }
  .wc-article ul { list-style: disc; padding-left: 22px; margin: 0 0 20px; }
  .wc-article ol { list-style: decimal; padding-left: 22px; margin: 0 0 20px; }
  .wc-article li { margin-bottom: 8px; }
  .wc-article strong { font-weight: 700; }
  .wc-article a { color: var(--head); }
  .wc-article [id] { scroll-margin-top: 96px; }

  .wc-article .sheet {
    background: var(--sheet);
    border-radius: 6px 10px 8px 12px;
    box-shadow: 0 1px 0 rgba(0, 0, 0, .04), 0 14px 34px -18px rgba(14, 17, 20, .35);
    padding: clamp(10px, 2vw, 22px);
    margin: 28px 0 8px;
    color: var(--graph);
  }
  .wc-article .sheet svg { display: block; width: 100%; height: auto; overflow: visible; }
  .wc-article .cap { font-size: 14px; color: var(--soft); margin: 8px 0 30px; text-align: center; }
  .wc-article .lbl { font-family: Caveat, cursive; font-weight: 700; fill: #0e1114; }

  .wc-article .three { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .wc-article .three .sheet { margin: 0; }
  .wc-article .three h3 { font-family: Caveat, cursive; font-size: 27px; font-weight: 700; margin: 6px 0 2px; color: var(--teal); }
  .wc-article .three p { font-size: 15px; line-height: 1.55; margin: 0; color: #2c3534; }

  .wc-article .five { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px; margin: 28px 0 10px; }
  .wc-article .five .sheet { margin: 0; padding: 12px 12px 14px; }
  .wc-article .five h3 { font-family: Caveat, cursive; font-size: 26px; font-weight: 700; margin: 0; color: var(--teal); line-height: 1; }
  .wc-article .five p { font-size: 14px; line-height: 1.5; margin: 6px 0 0; color: #2c3534; }

  .wc-article .dest { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 18px; align-items: center; }
  .wc-article .checks { list-style: none; padding: 0; margin: 0; }
  .wc-article .checks li { display: flex; gap: 10px; align-items: center; font-family: Caveat, cursive; font-size: 27px; font-weight: 700; color: var(--teal); margin: 2px 0; }
  .wc-article .checks svg { width: 30px; height: 30px; flex: none; }

  .wc-article .fam { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 14px; margin: 24px 0 8px; }
  .wc-article .fam div {
    background: var(--sheet);
    color: var(--graph);
    border-radius: 8px 5px 10px 6px;
    padding: 16px 16px 14px;
    position: relative;
    overflow: hidden;
    background-image: radial-gradient(ellipse 60% 70% at 88% 12%, rgba(1, 172, 149, .20), transparent 70%), radial-gradient(ellipse 50% 40% at 8% 100%, rgba(183, 197, 195, .55), transparent 70%);
  }
  .wc-article .fam b { display: block; font-family: Fraunces, Georgia, serif; font-weight: 500; font-size: 17px; line-height: 1.25; color: var(--teal); margin-bottom: 6px; }
  .wc-article .fam span { font-size: 14.5px; line-height: 1.5; display: block; }

  .wc-article .pull {
    font-family: Fraunces, Georgia, serif;
    font-weight: 500;
    font-size: clamp(21px, 2.6vw, 26px);
    line-height: 1.35;
    color: var(--head);
    border-left: 3px solid var(--acc);
    padding: 4px 0 4px 20px;
    margin: 30px 0;
  }

  .wc-article .note { font-size: 14px; color: var(--soft); }
  .wc-article .sources { font-size: 14.5px; line-height: 1.6; }
  .wc-article .sources li { margin-bottom: 6px; }
  .wc-article .sources a { color: var(--head); }
  .wc-article .refs { border-top: 1px solid var(--rule); margin-top: 56px; padding: 26px 0 60px; }

  .wc-article .tldr {
    background: var(--sheet);
    color: var(--graph);
    border-radius: 8px;
    padding: 18px 22px;
    margin: 30px 0 10px;
    border-left: 4px solid var(--acc);
  }
  .wc-article .tldr h2 { margin: 0 0 8px; font-size: 22px; color: var(--teal); }
  .wc-article .tldr ul { margin: 0; }
  .wc-article .tldr li { margin-bottom: 4px; }

  .wc-article .toc { display: flex; flex-wrap: wrap; gap: 8px 14px; margin: 6px 0 0; padding: 0; list-style: none; font-size: 14.5px; }
  .wc-article .toc a { color: var(--head); text-decoration: none; border-bottom: 1px solid var(--rule); }
  .wc-article .toc a:hover { border-color: var(--acc); }

  .wc-article .steps { display: none; list-style: none; padding: 0; margin: 10px 0 0; gap: 6px; flex-wrap: wrap; justify-content: center; }
  .wc-article .steps li { font-family: Caveat, cursive; font-weight: 700; font-size: 21px; background: #e4ece9; color: var(--teal); padding: 2px 12px; border-radius: 14px; margin: 0; }

  .wc-article .ask { background: var(--sheet); color: var(--graph); border-radius: 8px; padding: 18px 22px 16px; margin: 10px 0 22px; }
  .wc-article .ask ul { margin: 0 0 12px; }
  .wc-article button {
    font: inherit;
    font-size: 15px;
    min-height: 44px;
    padding: 0 18px;
    border-radius: 22px;
    border: 1.5px solid var(--teal);
    background: transparent;
    color: var(--teal);
    cursor: pointer;
  }
  .wc-article button:focus-visible,
  .wc-article a:focus-visible { outline: 3px solid var(--acc); outline-offset: 2px; }

  .wc-article .cta { background: var(--teal); color: #fff; border-radius: 10px; padding: 24px 26px; margin: 40px 0 0; }
  .wc-article .cta h2 { color: #fff; margin: 0 0 8px; font-size: 26px; }
  .wc-article .cta p { margin: 0 0 6px; color: #dbe7e5; }
  .wc-article .cta b { color: #fff; }
  .wc-article .cta a { color: #fff; text-decoration: underline; text-underline-offset: 3px; }

  .wc-article .who { display: flex; gap: 14px; align-items: flex-start; margin: 30px 0 0; font-size: 15px; color: var(--soft); }
  .wc-article .who .av {
    flex: none;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--acc);
    color: #fff;
    display: grid;
    place-items: center;
    font-family: Fraunces, serif;
    font-size: 20px;
  }

  .wc-article .bloom { transform-box: fill-box; transform-origin: center; opacity: 0; }
  .wc-article .on .bloom { animation: wc-bloom 1.8s cubic-bezier(.2, .7, .2, 1) both; animation-delay: var(--d, 0s); }
  @keyframes wc-bloom {
    0% { opacity: 0; transform: scale(.9); }
    60% { opacity: var(--o, .85); }
    100% { opacity: var(--o, .85); transform: scale(1); }
  }

  .wc-article .brush { stroke-dasharray: 1; stroke-dashoffset: 1; }
  .wc-article .on .brush { animation: wc-brush 2.6s ease-out both; animation-delay: var(--d, 0s); }
  @keyframes wc-brush { to { stroke-dashoffset: 0; } }

  .wc-article .on .bob { animation: wc-bob 3.4s ease-in-out infinite; animation-delay: var(--d, 0s); }
  .wc-article .bob { transform-box: fill-box; }
  @keyframes wc-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(var(--y, 14px)); }
  }

  .wc-article .drop { transform-box: fill-box; animation: wc-drop 4.5s ease-in-out infinite; }
  @keyframes wc-drop {
    0%, 15% { transform: translateY(-70px); opacity: 0; }
    35% { opacity: 1; }
    60%, 85% { transform: translateY(0); opacity: 1; }
    100% { transform: translateY(0); opacity: 0; }
  }

  @media (max-width: 860px) {
    .wc-article .five { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .wc-article .five .sheet:last-child { grid-column: 1 / -1; }
  }

  @media (max-width: 640px) {
    .wc-article .three { grid-template-columns: 1fr; }
    .wc-article .dest { grid-template-columns: 1fr; }
    .wc-article { font-size: 17px; }
  }

  @media (max-width: 600px) {
    .wc-article .hero-lbl { display: none; }
    .wc-article .steps { display: flex; }
  }
</style>
