---
import MediaSlot from './MediaSlot.astro';

const cases = [
  { id: 'A17', title: 'Cognitive Assembly case study', status: 'Coming soon' },
  { id: 'A18', title: 'Inspection case study', status: 'Coming soon' },
] as const;
---

<section class="bg-[#F7FAFA] py-16 md:py-[120px]">
  <div class="px-4 sm:px-8 lg:px-16">

    <div class="reveal mb-10 text-center md:mb-14">
      <h2
        class="font-inter font-bold leading-[1.1] tracking-[-0.025em] text-sp-heading"
        style="font-size: clamp(26px, 3vw, 44px);"
      >
        See it working
      </h2>
    </div>

    <!-- Demo -->
    <div class="reveal mx-auto max-w-[62rem]">
      <div class="relative">
        <MediaSlot
          id="A16"
          ratio="16 / 9"
          eager
          class="rounded-[24px] border border-sp-border"
        />
        <span
          class="pointer-events-none absolute left-4 top-4 z-10 rounded-full border border-white/25 bg-black/55 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.1em] text-white backdrop-blur-sm"
        >
          Simulation
        </span>
      </div>
    </div>

    <!-- Case-study slots -->
    <div class="reveal mx-auto mt-6 grid max-w-[62rem] grid-cols-1 gap-4 sm:grid-cols-2">
      {
        cases.map((item) => (
          <div class="rounded-[20px] border border-sp-border bg-white p-3">
            <MediaSlot id={item.id} ratio="16 / 9" class="rounded-[12px]" />
            <div class="mt-3 flex flex-wrap items-baseline justify-between gap-2 px-1 pb-1">
              <h3 class="text-[14px] font-semibold text-sp-heading">{item.title}</h3>
              <span class="text-[12px] text-sp-body/70">{item.status}</span>
            </div>
          </div>
        ))
      }
    </div>

  </div>
</section>
