---
const stages = [
  {
    label: 'See',
    body: 'RGB-D camera input',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1.8 12S5.2 5.5 12 5.5 22.2 12 22.2 12 18.8 18.5 12 18.5 1.8 12 1.8 12z"/><circle cx="12" cy="12" r="3"/></svg>`,
  },
  {
    label: 'Locate',
    body: 'Exact 6D pose matched to CAD',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3"/><line x1="12" y1="1.6" x2="12" y2="5"/><line x1="12" y1="19" x2="12" y2="22.4"/><line x1="1.6" y1="12" x2="5" y2="12"/><line x1="19" y1="12" x2="22.4" y2="12"/></svg>`,
  },
  {
    label: 'Plan',
    body: 'IK and collision-aware motion',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="5.5" cy="6" r="2.4"/><circle cx="18.5" cy="18" r="2.4"/><path d="M7.9 6h5.6a3.5 3.5 0 0 1 0 7h-3a3.5 3.5 0 0 0 0 7h5.6"/></svg>`,
  },
  {
    label: 'Act',
    body: 'Grasp, place, verify',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.6v5.6"/><path d="M6.4 8.2h11.2l-1.6 4.3H8l-1.6-4.3z"/><path d="M9 12.5v4.4M15 12.5v4.4"/><path d="M8.6 19.6h6.8"/></svg>`,
  },
];
---

<section class="bg-[#F7FAFA] py-16 md:py-[120px]">
  <div class="px-4 sm:px-8 lg:px-16">

    <div class="reveal mx-auto max-w-[46rem] text-center">
      <p class="section-label mb-4">The intelligence layer</p>
      <h2
        class="mb-6 font-inter font-bold leading-[1.08] tracking-[-0.025em] text-sp-heading"
        style="font-size: clamp(28px, 3.4vw, 50px);"
      >
        Spatia AssembleX
      </h2>
      <p
        class="mx-auto mb-5 text-[17px] font-medium leading-[1.6] text-sp-green"
        style="letter-spacing: -0.01em;"
      >
        From seeing the part to completing the task, Spatia brings intelligence directly to the robot.
      </p>
      <p class="mx-auto text-[14.5px] leading-[1.75] text-sp-body">
        AssembleX is the platform behind every Spatia solution. It turns a CAD model into a live 6D
        pose, then carries that pose through calibration, grasp definition, motion planning and
        execution, so the robot can act on what it sees.
      </p>
    </div>

    <!-- Pipeline -->
    <div
      class="reveal reveal-delay-2 relative mt-14 rounded-[28px] border border-sp-border bg-white p-7 sm:p-10 lg:p-12"
    >
      <ol class="grid grid-cols-1 gap-7 sm:grid-cols-2 sm:gap-x-6 sm:gap-y-10 lg:grid-cols-4 lg:gap-x-7">
        {
          stages.map((stage, i) => (
            <li class="relative flex items-start gap-4 lg:flex-col lg:items-center lg:gap-0 lg:text-center">
              <span
                class="flex h-[58px] w-[58px] flex-shrink-0 items-center justify-center rounded-full border border-sp-green/25 bg-sp-green-light"
                style="color: #1E686E;"
              >
                <Fragment set:html={stage.icon} />
              </span>

              <div class="pt-1 lg:mt-5 lg:pt-0">
                <span class="mb-1.5 block font-mono text-[10.5px] font-semibold tracking-[0.12em] text-sp-green/60">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <h3
                  class="mb-1.5 text-[19px] font-semibold leading-tight tracking-[-0.02em] text-sp-heading"
                >
                  {stage.label}
                </h3>
                <p class="text-[13px] leading-[1.6] text-sp-body">{stage.body}</p>
              </div>

              {i < stages.length - 1 && (
                <span
                  class="pointer-events-none absolute -right-[1.35rem] top-[1.45rem] hidden text-sp-green/45 lg:block"
                  aria-hidden="true"
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="9 5 16 12 9 19" />
                  </svg>
                </span>
              )}
            </li>
          ))
        }
      </ol>
    </div>

    <div class="reveal mt-11 flex justify-center">
      <a
        href="/technology"
        class="inline-flex items-center justify-center rounded-md border border-sp-border px-6 py-3 text-[14px] font-semibold text-sp-heading transition-colors duration-200 hover:border-sp-green/40 hover:text-sp-green"
      >
        See the technology
        <span class="ml-2" aria-hidden="true">&rarr;</span>
      </a>
    </div>

  </div>
</section>
