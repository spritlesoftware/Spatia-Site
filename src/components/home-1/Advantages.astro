---
const icons = {
  cad: `<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>`,
  fixture: `<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3"/><path d="M21 8V5a2 2 0 0 0-2-2h-3"/><path d="M3 16v3a2 2 0 0 0 2 2h3"/><path d="M16 21h3a2 2 0 0 0 2-2v-3"/><line x1="2.5" y1="12" x2="21.5" y2="12" stroke-dasharray="3 3"/></svg>`,
  robot: `<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 21h14"/><rect x="7" y="10" width="10" height="8" rx="1.6"/><path d="M12 10V6.5"/><circle cx="12" cy="4.2" r="1.5"/><path d="M9.5 14v2.5M14.5 14v2.5"/></svg>`,
  debug: `<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="4"/><line x1="12" y1="1.5" x2="12" y2="5"/><line x1="12" y1="19" x2="12" y2="22.5"/><line x1="1.5" y1="12" x2="5" y2="12"/><line x1="19" y1="12" x2="22.5" y2="12"/></svg>`,
};

const pose = [
  { k: 'X', v: '412.80', u: 'mm' },
  { k: 'Y', v: '-87.21', u: 'mm' },
  { k: 'Z', v: '156.04', u: 'mm' },
  { k: 'RX', v: '0.12', u: '°' },
  { k: 'RY', v: '-1.48', u: '°' },
  { k: 'RZ', v: '89.95', u: '°' },
];
const causes = ['Calibration', 'Occlusion', 'Lighting', 'Grasp'];

// A small L-bracket centred on the origin, reused by the Fixture-free visual
const bracket = 'M-20 -16h40v12h-26v20h-14z';
---

<section class="bg-white py-16 md:py-[120px]">
  <div class="px-4 sm:px-8 lg:px-16">

    <h2
      class="reveal mb-12 text-center font-inter font-bold leading-[1.1] tracking-[-0.02em] text-sp-heading md:mb-16"
      style="font-size: clamp(26px, 3vw, 44px);"
    >
      Why manufacturers choose us
    </h2>

    <div class="mx-auto grid max-w-[68rem] grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3" data-adv>

      <!-- 01 · Start from CAD (wide) -->
      <article class="adv-card reveal group grid overflow-hidden rounded-[20px] border border-sp-border bg-white md:col-span-2 md:grid-cols-[1fr_1.15fr]">
        <div class="order-2 flex flex-col p-6 md:order-1 lg:p-7">
          <div class="flex items-center gap-3">
            <span class="adv-icon"><Fragment set:html={icons.cad} /></span>
            <span class="adv-index">01</span>
          </div>
          <h3 class="adv-title">Start from CAD</h3>
          <p class="adv-body">
            Your existing CAD model is the only input a new part needs. No image collection, no labeling, no retraining.
          </p>
          <ul class="mt-6 flex flex-wrap gap-2 md:mt-auto md:pt-6" aria-hidden="true">
            {['Images', 'Labels', 'Retraining'].map((t) => (
              <li class="inline-flex items-center gap-1.5 rounded-full border border-sp-border bg-[#F7FAFA] px-3 py-1 text-[12px] font-medium text-sp-body/60 line-through decoration-sp-body/40">
                <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>
                {t}
              </li>
            ))}
          </ul>
        </div>

        <div class="adv-visual order-1 min-h-[170px] md:order-2" aria-hidden="true">
          <svg class="absolute inset-0 h-full w-full" viewBox="0 0 360 220" preserveAspectRatio="xMidYMid meet" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <!-- CAD file -->
            <g transform="translate(34 58)">
              <path d="M0 8a8 8 0 0 1 8-8h44l18 18v78a8 8 0 0 1-8 8H8a8 8 0 0 1-8-8z" fill="#fff" stroke="#1E686E" stroke-opacity=".35" stroke-width="1.4" />
              <path d="M52 0v14a4 4 0 0 0 4 4h14" stroke="#1E686E" stroke-opacity=".35" stroke-width="1.4" />
              <path d="M35 34 51 43 35 52 19 43z M19 43v16l16 9 16-9V43 M35 52v16" stroke="#1E686E" stroke-width="1.2" />
              <rect x="12" y="80" width="46" height="14" rx="4" fill="#1E686E" />
              <text x="35" y="90" text-anchor="middle" font-size="8" font-weight="700" font-family="ui-monospace, monospace" letter-spacing=".5" fill="#fff">.STEP</text>
            </g>
            <!-- Data link -->
            <path d="M118 112h96" stroke="#1E686E" stroke-opacity=".2" stroke-width="1.4" />
            <path class="cad-flow" d="M118 112h96" stroke="#1E686E" stroke-width="1.4" stroke-dasharray="4 8" />
            <path d="M210 107l6 5-6 5" stroke="#1E686E" stroke-width="1.4" />
            <!-- Model drawn from the CAD -->
            <g transform="translate(278 112)">
              <path class="cad-fill" d="M0-46 42-22 0 2-42-22z M-42-22v44L0 46V2z M42-22v44L0 46V2z" fill="#1E686E" />
              <path class="cad-draw" pathLength="1" d="M0-46 42-22 0 2-42-22z M-42-22v44L0 46 42 22v-44 M0 2v44" stroke="#1E686E" stroke-width="1.6" />
              <path d="M0 2-42 22M0 2l42 20" stroke="#1E686E" stroke-opacity=".3" stroke-width="1" stroke-dasharray="2 3" />
              <g class="cad-nodes" fill="#1E686E">
                <circle cx="0" cy="-46" r="2.6" /><circle cx="42" cy="-22" r="2.6" /><circle cx="-42" cy="-22" r="2.6" /><circle cx="0" cy="2" r="2.6" />
                <circle cx="-42" cy="22" r="2.6" /><circle cx="42" cy="22" r="2.6" /><circle cx="0" cy="46" r="2.6" />
              </g>
            </g>
          </svg>
        </div>
      </article>

      <!-- 02 · Fixture-free -->
      <article class="adv-card reveal reveal-delay-1 group flex flex-col overflow-hidden rounded-[20px] border border-sp-border bg-white">
        <div class="adv-visual h-[170px]" aria-hidden="true">
          <svg class="absolute inset-0 h-full w-full" viewBox="0 0 240 220" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <rect x="24" y="30" width="192" height="160" rx="14" fill="#fff" stroke="#1E686E" stroke-opacity=".15" stroke-width="1.2" />
            <g class="fx-part">
              <path d={bracket} fill="#1E686E" fill-opacity=".14" stroke="#1E686E" stroke-width="1.4" />
            </g>
            <g class="fx-lock" stroke="#1E686E" stroke-width="1.6">
              <path d="M-32-22v-10h10M32-22v-10h-10M-32 22v10h10M32 22v10h-10" />
              <path d="M0-5v10M-5 0h10" stroke-width="1.2" />
            </g>
          </svg>
          <span class="absolute bottom-4 left-1/2 -translate-x-1/2 rounded-full bg-white px-2.5 py-1 font-mono text-[10px] font-semibold tracking-[0.12em] text-sp-green shadow-[0_2px_8px_rgba(17,24,39,0.06)]">
            <span class="mr-1.5 inline-block h-1.5 w-1.5 rounded-full bg-[#10B981] align-middle"></span>LOCKED
          </span>
        </div>
        <div class="flex flex-1 flex-col p-6 lg:p-7">
          <div class="flex items-center gap-3">
            <span class="adv-icon"><Fragment set:html={icons.fixture} /></span>
            <span class="adv-index">02</span>
          </div>
          <h3 class="adv-title">Fixture-free</h3>
          <p class="adv-body">The system locates the actual part in real time, reducing or removing custom jigs and fixtures.</p>
        </div>
      </article>

      <!-- 03 · Robot-agnostic -->
      <article class="adv-card reveal group flex flex-col overflow-hidden rounded-[20px] border border-sp-border bg-white">
        <div class="adv-visual h-[170px]" aria-hidden="true">
          <svg class="absolute inset-0 h-full w-full" viewBox="0 0 240 220" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <g stroke="#1E686E" stroke-width="1.4">
              <path d="M120 72 50 138M120 72v66M120 72l70 66" stroke-opacity=".18" />
              <path class="rb-flow" d="M120 72 50 138M120 72v66M120 72l70 66" stroke-dasharray="3 7" />
            </g>
            <!-- Vision stack -->
            <rect x="88" y="42" width="64" height="34" rx="10" fill="#1E686E" />
            <circle cx="108" cy="59" r="6" stroke="#fff" stroke-width="1.6" />
            <circle cx="108" cy="59" r="2" fill="#fff" />
            <path d="M122 54h18M122 60h12M122 66h15" stroke="#fff" stroke-opacity=".7" stroke-width="1.6" />
            <!-- Three different arms -->
            <g class="rb-arm" style="--d:0s" stroke="#1E686E" stroke-width="1.6">
              <path d="M36 186h28M42 186v-6h16v6M50 180v-20l14-14 8 6" /><circle cx="50" cy="160" r="3" fill="#fff" /><circle cx="64" cy="146" r="3" fill="#fff" />
            </g>
            <g class="rb-arm" style="--d:.6s" stroke="#1E686E" stroke-width="1.6">
              <path d="M106 186h28M112 186v-6h16v6M120 180v-28l-12-10 4-10" /><circle cx="120" cy="152" r="3" fill="#fff" /><circle cx="108" cy="142" r="3" fill="#fff" />
            </g>
            <g class="rb-arm" style="--d:1.2s" stroke="#1E686E" stroke-width="1.6">
              <path d="M176 186h28M182 186v-6h16v6M190 180v-16h-16l-6-12" /><circle cx="190" cy="164" r="3" fill="#fff" /><circle cx="174" cy="164" r="3" fill="#fff" />
            </g>
            <g font-size="8" font-family="ui-monospace, monospace" font-weight="600" letter-spacing="1" fill="#1E686E" fill-opacity=".55" text-anchor="middle">
              <text x="50" y="202">A</text><text x="120" y="202">B</text><text x="190" y="202">C</text>
            </g>
          </svg>
        </div>
        <div class="flex flex-1 flex-col p-6 lg:p-7">
          <div class="flex items-center gap-3">
            <span class="adv-icon"><Fragment set:html={icons.robot} /></span>
            <span class="adv-index">03</span>
          </div>
          <h3 class="adv-title">Robot-agnostic</h3>
          <p class="adv-body">One vision stack designed to work across robot brands, so perception is reusable as your fleet grows.</p>
        </div>
      </article>

      <!-- 04 · Debuggable (wide) -->
      <article class="adv-card reveal reveal-delay-1 group grid overflow-hidden rounded-[20px] border border-sp-border bg-white md:col-span-2 md:grid-cols-[1fr_1.15fr]">
        <div class="order-2 flex flex-col p-6 md:order-1 lg:p-7">
          <div class="flex items-center gap-3">
            <span class="adv-icon"><Fragment set:html={icons.debug} /></span>
            <span class="adv-index">04</span>
          </div>
          <h3 class="adv-title">Debuggable, not a black box</h3>
          <p class="adv-body">
            The output is an explicit 6D pose. When something fails, the cause is traceable: calibration, occlusion, lighting or grasp.
          </p>
        </div>

        <div class="adv-visual order-1 flex items-center justify-center p-5 md:order-2 lg:p-6" aria-hidden="true">
          <div class="relative w-full max-w-[320px] rounded-2xl border border-sp-border bg-white p-4 shadow-[0_18px_40px_-24px_rgba(17,24,39,0.25)]">
            <div class="mb-3 flex items-center justify-between">
              <span class="font-mono text-[10px] font-semibold tracking-[0.16em] text-sp-body/60">6D POSE</span>
              <span class="flex items-center gap-1.5 font-mono text-[10px] font-semibold tracking-[0.12em] text-[#10B981]">
                <span class="relative flex h-1.5 w-1.5">
                  <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#10B981] opacity-60"></span>
                  <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-[#10B981]"></span>
                </span>
                LIVE
              </span>
            </div>
            <div class="grid grid-cols-3 gap-1.5">
              {pose.map((p) => (
                <div class="rounded-lg bg-[#F7FAFA] px-2.5 py-2">
                  <div class="font-mono text-[9px] font-semibold tracking-[0.12em] text-sp-body/50">{p.k}</div>
                  <div class="font-mono text-[13px] font-semibold tabular-nums text-sp-heading">
                    <span data-pose={p.v}>{p.v}</span><span class="ml-0.5 text-[10px] font-medium text-sp-body/50">{p.u}</span>
                  </div>
                </div>
              ))}
            </div>
            <div class="mt-4 space-y-1.5 border-t border-sp-border pt-4">
              {causes.map((c, i) => (
                <div class="dbg-row flex items-center justify-between rounded-lg px-2.5 py-1.5" data-cause={i}>
                  <span class="text-[12.5px] font-medium text-sp-heading">{c}</span>
                  <span class="dbg-status flex items-center gap-1.5 font-mono text-[10px] font-semibold tracking-[0.1em]">
                    <span class="dbg-dot h-1.5 w-1.5 rounded-full"></span>
                    <span class="dbg-label">OK</span>
                  </span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </article>

    </div>
  </div>
</section>

<style>
  /* ── Shared card bits ─────────────────────────────── */
  .adv-card {
    /* opacity kept so the scroll-reveal fade still works alongside the hover lift */
    transition: opacity 0.65s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease, box-shadow 0.4s ease, transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .adv-card:hover {
    border-color: rgba(30, 104, 110, 0.3);
    box-shadow: 0 28px 60px -34px rgba(30, 104, 110, 0.45);
    transform: translateY(-3px);
  }
  .adv-icon {
    display: flex;
    height: 34px;
    width: 34px;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    border: 1px solid rgba(30, 104, 110, 0.15);
    background: linear-gradient(to bottom, #fff, #E3EFEF);
    color: #1E686E;
    box-shadow: inset 0 1px 0 #fff, 0 6px 14px -8px rgba(30, 104, 110, 0.45);
    transition: background 0.3s ease, color 0.3s ease, border-color 0.3s ease;
  }
  .adv-card:hover .adv-icon {
    background: #1E686E;
    border-color: #1E686E;
    color: #fff;
  }
  .adv-index {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: rgba(75, 85, 99, 0.5);
  }
  .adv-title {
    margin-top: 1.1rem;
    font-size: 17px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: #111827;
  }
  .adv-body {
    margin-top: 0.5rem;
    font-size: 14.5px;
    line-height: 1.65;
    color: #4B5563;
  }
  .adv-visual {
    position: relative;
    background-color: #F6F9F9;
    background-image: radial-gradient(rgba(30, 104, 110, 0.13) 1px, transparent 1px);
    background-size: 16px 16px;
  }

  /* ── 01 CAD: file streams into a model that draws itself ── */
  .cad-flow { animation: cad-flow 1.2s linear infinite; }
  @keyframes cad-flow { to { stroke-dashoffset: -24; } }
  .cad-draw { stroke-dasharray: 1; stroke-dashoffset: 1; }
  .cad-fill { opacity: 0; }
  .cad-nodes { opacity: 0; }
  [data-adv].is-in .cad-draw  { animation: cad-draw 1.6s cubic-bezier(0.65, 0, 0.35, 1) 0.3s forwards; }
  [data-adv].is-in .cad-fill  { animation: fade-to 0.8s ease 1.6s forwards; --to: 0.1; }
  [data-adv].is-in .cad-nodes { animation: fade-to 0.6s ease 1.5s forwards; --to: 1; }
  @keyframes cad-draw { to { stroke-dashoffset: 0; } }
  @keyframes fade-to { to { opacity: var(--to); } }

  /* ── 02 Fixture-free: part lands anywhere, tracker locks on ── */
  .fx-part, .fx-lock {
    transform: translate(88px, 92px) rotate(-14deg);
    animation: fx-move 9s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }
  .fx-lock { animation-delay: 0.35s; }
  @keyframes fx-move {
    0%, 22%   { transform: translate(88px, 92px) rotate(-14deg); }
    33%, 55%  { transform: translate(156px, 126px) rotate(22deg); }
    66%, 88%  { transform: translate(104px, 146px) rotate(-38deg); }
    100%      { transform: translate(88px, 92px) rotate(-14deg); }
  }

  /* ── 03 Robot-agnostic: one stack feeding every arm ── */
  .rb-flow { animation: cad-flow 1.4s linear infinite; }
  .rb-arm { animation: rb-pulse 1.8s ease-in-out infinite; animation-delay: var(--d); }
  @keyframes rb-pulse {
    0%, 100% { opacity: 0.55; }
    50%      { opacity: 1; }
  }

  /* ── 04 Debuggable: failure causes are traced ── */
  .dbg-status { color: #10B981; }
  .dbg-dot { background: #10B981; }
  .dbg-row { transition: background-color 0.3s ease; }
  .dbg-row.is-flag { background: #FFF7ED; }
  .dbg-row.is-flag .dbg-status { color: #D97706; }
  .dbg-row.is-flag .dbg-dot { background: #F59E0B; box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.2); }

  @media (prefers-reduced-motion: reduce) {
    .cad-flow, .rb-flow, .rb-arm, .fx-part, .fx-lock { animation: none; }
    .fx-part, .fx-lock { transform: translate(120px, 110px) rotate(-14deg); }
    .cad-draw { stroke-dashoffset: 0; }
    .cad-fill { opacity: 0.1; }
    .cad-nodes { opacity: 1; }
    [data-adv].is-in .cad-draw, [data-adv].is-in .cad-fill, [data-adv].is-in .cad-nodes { animation: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-adv]').forEach((root) => {
    const values = Array.from(root.querySelectorAll<HTMLElement>('[data-pose]'));
    const rows = Array.from(root.querySelectorAll<HTMLElement>('[data-cause]'));
    let timer: number | undefined;
    let tick = 0;

    const step = () => {
      // Pose readout: tiny sensor-noise jitter around the base values
      values.forEach((el) => {
        const base = parseFloat(el.dataset.pose || '0');
        el.textContent = (base + (Math.random() - 0.5) * 0.08).toFixed(2);
      });
      // Every few ticks, trace a different failure cause
      tick++;
      const flagged = Math.floor(tick / 3) % (rows.length + 1); // one quiet cycle with all OK
      rows.forEach((row, i) => {
        const on = i === flagged;
        row.classList.toggle('is-flag', on);
        const label = row.querySelector('.dbg-label');
        if (label) label.textContent = on ? 'CHECK' : 'OK';
      });
    };

    new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) {
        root.classList.add('is-in');
        if (!timer) timer = window.setInterval(step, 900);
      } else {
        window.clearInterval(timer);
        timer = undefined;
      }
    }, { threshold: 0.2 }).observe(root);
  });
</script>
