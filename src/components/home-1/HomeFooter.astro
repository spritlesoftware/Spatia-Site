---
import logoSpatia from '../../assets/logo-spatia.svg';

const platformLinks = [{ label: 'Spatia AssembleX', href: '/technology' }];

const solutionLinks = [
  { label: 'Cognitive Assembly', href: '/cognitive-assembly' },
  { label: 'Vernier', href: '/contact?interest=vernier' },
  { label: 'Zero-CAD platform', href: '/contact?interest=zero-cad' },
];

const companyLinks = [
  { label: 'Technology', href: '/technology' },
  { label: 'Contact', href: '/contact' },
];

const legalLinks = [
  { label: 'Privacy', href: '/privacy' },
  { label: 'Terms', href: '/terms' },
];
---

<footer class="border-t border-sp-border bg-white">
  <div class="px-4 py-10 sm:px-8 sm:py-16 lg:px-16">

    <div class="grid grid-cols-2 gap-10 md:grid-cols-4 md:gap-8">

      <div class="col-span-2 md:col-span-1">
        <a href="/" class="mb-5 inline-block">
          <img src={logoSpatia.src} alt="Spatia" class="h-10 w-auto" />
        </a>
        <p class="max-w-[220px] text-[13px] leading-[1.75] text-sp-body">
          Spatia enables machines to perceive, understand and act in the real world.
        </p>
      </div>

      <div>
        <h4 class="section-label mb-5">Platform</h4>
        <ul class="flex flex-col gap-3.5">
          {platformLinks.map((link) => <li><a href={link.href} class="footer-link">{link.label}</a></li>)}
        </ul>
      </div>

      <div>
        <h4 class="section-label mb-5">Solutions</h4>
        <ul class="flex flex-col gap-3.5">
          {solutionLinks.map((link) => <li><a href={link.href} class="footer-link">{link.label}</a></li>)}
        </ul>
      </div>

      <div>
        <h4 class="section-label mb-5">Company</h4>
        <ul class="flex flex-col gap-3.5">
          {companyLinks.map((link) => <li><a href={link.href} class="footer-link">{link.label}</a></li>)}
        </ul>
        <h4 class="section-label mb-5 mt-8">Legal</h4>
        <ul class="flex flex-col gap-3.5">
          {legalLinks.map((link) => <li><a href={link.href} class="footer-link">{link.label}</a></li>)}
        </ul>
      </div>

    </div>

    <div
      class="mt-12 flex flex-col items-start justify-between gap-2 border-t border-sp-border pt-6 sm:flex-row sm:items-center"
    >
      <span class="text-[12px] text-sp-body/60"></span>
      <span class="text-[12px] text-sp-body/60">&copy; 2026 Spatia. All rights reserved.</span>
    </div>

  </div>
</footer>

<style>
  .footer-link {
    font-size: 14px;
    color: #4b5563;
    transition: color 150ms;
  }
  .footer-link:hover {
    color: #111827;
  }
</style>
