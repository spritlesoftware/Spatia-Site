---
const tags = ['CAD-native', 'Robot-agnostic', 'Edge-deployed', 'No training data'];
---

<section class="border-y border-sp-border bg-white py-8 md:py-10">
  <div class="px-4 sm:px-8 lg:px-16">
    <ul class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 md:gap-x-14">
      {
        tags.map((tag) => (
          <li class="flex items-center gap-2.5">
            <span
              class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-sp-green"
              aria-hidden="true"
            />
            <span class="text-[13px] font-semibold uppercase tracking-[0.1em] text-sp-body">
              {tag}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
